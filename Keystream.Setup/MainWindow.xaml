<Window x:Class="Keystream.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keystream Setup"
        Width="520" Height="290"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B0E14"
        Foreground="#E6EDF3"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"
        Icon="app.ico">

    <Window.Resources>
        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#075985" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#475569" />
                                <Setter Property="Foreground" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F172A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress Bar Style -->
        <Style x:Key="SetupProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#0284C7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#0284C7" CornerRadius="4" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LanguageComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3247"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D4A6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LanguageComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1E222D"/>
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="BorderBrush" Value="#3A4152"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxDropDownHeight" Value="180"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource LanguageComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#1E222D" BorderBrush="#3A4152" BorderThickness="2" CornerRadius="6">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#B9C1D1" StrokeThickness="1.6"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,26,0" VerticalAlignment="Center"/>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="#1B1F28" BorderBrush="#3A4152" BorderThickness="2" CornerRadius="6" ClipToBounds="True"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ScrollViewer.Resources>
                                            <!-- Thin ScrollBar style duplicated here: the Popup ScrollBar does not reliably pick up the ComboBox.Resources copy. -->
                                            <Style TargetType="ScrollBar">
                                                <Setter Property="Width" Value="2"/>
                                                <Setter Property="MinWidth" Value="2"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ScrollBar">
                                                            <Grid Background="Transparent">
                                                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                                    <Track.DecreaseRepeatButton>
                                                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                                                    </Track.DecreaseRepeatButton>
                                                                    <Track.IncreaseRepeatButton>
                                                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                                                    </Track.IncreaseRepeatButton>
                                                                    <Track.Thumb>
                                                                        <Thumb x:Name="Thumb" Background="#3A4152" BorderThickness="0">
                                                                            <Thumb.Template>
                                                                                <ControlTemplate TargetType="Thumb">
                                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="1"/>
                                                                                </ControlTemplate>
                                                                            </Thumb.Template>
                                                                        </Thumb>
                                                                    </Track.Thumb>
                                                                </Track>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger SourceName="Thumb" Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Thumb" Property="Background" Value="#4A5570"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ScrollViewer.Resources>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Content Area -->
    <Grid Margin="24,22,24,20">

        <!-- 1. WELCOME / READY PANEL -->
        <Grid x:Name="pnlWelcome" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ComboBox x:Name="cmbLanguage" Panel.ZIndex="1" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Width="112" Height="26" FontSize="12" Style="{StaticResource LanguageComboBoxStyle}" SelectionChanged="cmbLanguage_SelectionChanged">
                <ComboBox.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="2"/>
                        <Setter Property="MinWidth" Value="2"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb x:Name="Thumb" Background="#3A4152" BorderThickness="0">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="1"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger SourceName="Thumb" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Thumb" Property="Background" Value="#4A5570"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ComboBox.Resources>
            </ComboBox>
            <TextBlock x:Name="txtWelcomeTitle" Grid.Row="1" Text="Install Keystream" FontSize="16" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,16" />

            <!-- Install Location Box -->
            <Border Grid.Row="2" Background="#161F2E" BorderBrush="#253346" BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="txtInstallLocationLabel" Text="Install Location:" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtInstallPath" Text="%LOCALAPPDATA%\Keystream" FontSize="12" Foreground="#E2E8F0" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" />
                        <Button x:Name="btnBrowse" Grid.Column="1" Content="Browse..." Width="80" Height="28" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="btnBrowse_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Shortcut option -->
            <CheckBox Grid.Row="3" x:Name="chkDesktop" Content="Create desktop shortcut" IsChecked="True" FontSize="12" Foreground="#E2E8F0" />

            <!-- Buttons -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancel" Content="Cancel" Width="85" Height="32" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="btnCancel_Click" />
                <Button x:Name="btnInstall" Content="Install Now" Width="130" Height="32" Style="{StaticResource PrimaryButtonStyle}" FontWeight="SemiBold" Click="btnInstall_Click" />
            </StackPanel>
        </Grid>

        <!-- 2. INSTALLING PROGRESS PANEL -->
        <Grid x:Name="pnlInstalling" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="txtInstallingTitle" Grid.Row="1" Text="Installing Keystream..." FontSize="16" FontWeight="SemiBold" Foreground="#F1F5F9" />
            <TextBlock x:Name="txtInstallingSubtitle" Grid.Row="2" Text="Please wait while setup prepares the application..."
                       Foreground="#94A3B8" FontSize="12" Margin="0,6,0,24" />

            <TextBlock Grid.Row="3" x:Name="txtStatus" Text="Preparing installation..." FontSize="13" FontWeight="Medium" Foreground="#38BDF8" Margin="0,0,0,8" />
            <ProgressBar Grid.Row="4" x:Name="pbProgress" Style="{StaticResource SetupProgressBarStyle}" Minimum="0" Maximum="100" Value="10" />
            <TextBlock Grid.Row="5" x:Name="txtDetail" Text="Checking system..." FontSize="11" Foreground="#64748B" Margin="0,8,0,0" />
        </Grid>

        <!-- 3. FINISHED PANEL -->
        <Grid x:Name="pnlFinished" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Success Header (Cyber Glowing Badge) -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0" BorderThickness="1.5">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#38BDF8" Offset="0.0" />
                            <GradientStop Color="#0284C7" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F283D" Offset="0.0" />
                            <GradientStop Color="#091827" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#38BDF8" BlurRadius="12" Opacity="0.45" ShadowDepth="0" />
                    </Border.Effect>
                    <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 1 7 L 6 12 L 15 2"
                          Stroke="#38BDF8" StrokeThickness="2.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Margin="0,1,0,0" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="txtFinishedTitle" Text="Installation Complete!" FontSize="17" FontWeight="Bold" Foreground="#F1F5F9" />
                    <TextBlock x:Name="txtFinishedSubtitle" Text="Keystream is ready to use." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Warning Notice (if driver restart required) -->
            <Border Grid.Row="2" x:Name="pnlDriverNotice" Visibility="Collapsed"
                    Background="#2E2310" BorderBrush="#D97706" BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="txtDriverNoticeTitle" Text="⚠️ Restart Required" FontWeight="SemiBold" FontSize="12" Foreground="#FBBF24" />
                    <TextBlock x:Name="txtDriverNoticeBody" Text="The Interception driver has been installed. A computer restart is required for the deck to recognize secondary keyboards."
                               FontSize="11" Foreground="#FDE68A" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="16" />
                </StackPanel>
            </Border>

            <!-- Options -->
            <StackPanel Grid.Row="3" Margin="0,4,0,0">
                <CheckBox x:Name="chkLaunch" Content="Launch Keystream now" IsChecked="True" FontSize="12" Foreground="#E2E8F0" Margin="0,0,0,8" />
                <CheckBox x:Name="chkRunAtStartup" Content="Run at Start Up" IsChecked="False" FontSize="12" Foreground="#E2E8F0" />
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnRestartLater" Visibility="Collapsed" Content="Restart Later" Width="100" Height="32" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="btnRestartLater_Click" />
                <Button x:Name="btnRestartNow" Visibility="Collapsed" Content="Restart Now" Width="130" Height="32" Style="{StaticResource PrimaryButtonStyle}" Background="#D97706" FontWeight="SemiBold" Click="btnRestartNow_Click" />
                <Button x:Name="btnFinish" Content="Finish" Width="100" Height="32" Style="{StaticResource PrimaryButtonStyle}" FontWeight="SemiBold" Click="btnFinish_Click" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>
