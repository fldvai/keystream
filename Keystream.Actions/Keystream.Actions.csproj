<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keystream.Core\Keystream.Core.csproj" />
    <!-- Sound playback (v2.9.23): WAV/MP3 + Media Foundation formats -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Note: NAudio's dependency NAudio.WinForms adds a WindowsDesktop
         framework reference to consumers' runtimeconfigs. Harmless for
         the WPF app (that framework is its own prerequisite); the VM
         self-check runner strips it from ITS generated runtimeconfig
         before running, because the checks touch no WinForms types. -->
  </ItemGroup>

</Project>
