<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Keystream</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Title>Keystream</Title>
    <Product>Keystream</Product>
    <Description>Multi-Keyboard Macro Deck for Windows</Description>
    <Company>Keystream</Company>
    <Authors>Keystream</Authors>
    <Copyright>Copyright © 2026 Keystream. All rights reserved.</Copyright>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <RootNamespace>Keystream.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keystream.Core\Keystream.Core.csproj" />
    <ProjectReference Include="..\Keystream.Windows\Keystream.Windows.csproj" />
    <ProjectReference Include="..\Keystream.Actions\Keystream.Actions.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <Content Include="..\Keystream.Windows\interception.dll" Link="interception.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\keystream.png" />
    <Resource Include="Assets\*.ttf" />
    <Resource Include="app.ico" />
    <!-- Default Global card icons (user-supplied PNGs): embedded so the
         first-run seeder can import them into %AppData%\Keystream\Icons
         without depending on publish layout. Manifest names are
         Keystream.App.Assets.DefaultGlobal.<File>.png; AppHost matches
         by suffix, never by a hardcoded full name. -->
    <EmbeddedResource Include="Assets\DefaultGlobal\*.png" />
    <None Update="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
