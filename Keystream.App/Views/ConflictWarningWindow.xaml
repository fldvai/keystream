<Window WindowStyle="None" x:Class="Keystream.App.Views.ConflictWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Keystream.App.Views"
        xmlns:loc="clr-namespace:Keystream.App.Localization"
        Title="{Binding [S0164], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Height="285" Width="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Foreground="#E8EAF0"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="14">
        <!-- Shadow proxy layer: isolated shadow layer, prevents text blur and border artifacts -->
        <Border CornerRadius="16" Background="#0A0C14" Margin="2">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.8" BlurRadius="16" ShadowDepth="4" Direction="315"/>
            </Border.Effect>
        </Border>

        <views:ChamferBorder Chamfer="20" ClipChild="True"
                             Background="{StaticResource WindowBackgroundBrush}"
                             BorderBrush="{StaticResource ChassisMilledBevelBrush}"
                             InnerBevelBrush="{StaticResource ChassisInnerBevelBrush}"
                             BorderThickness="3.0"
                             SpecularTopHighlight="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="#1E86E0" BorderThickness="0,0,0,1.5"
                        Background="{StaticResource HeaderBackgroundBrush}"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Height="46" Margin="18,0,12,0">
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="15" FontWeight="Bold" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ShellChromeButton}" HorizontalAlignment="Right"
                                Click="Close_Click" ToolTip="{Binding [S0003], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                            <TextBlock Text="&#x2715;" FontSize="11" FontFamily="{StaticResource CyberTechFont}" FontWeight="SemiBold" Foreground="#B9C1D1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="22,18,22,0">
                    <TextBlock Text="{Binding [S0165], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="15" FontWeight="Bold" FontFamily="{StaticResource CyberTechFont}" Foreground="#FFC65C"/>
                    <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="13" FontFamily="{StaticResource CyberTechFont}" LineHeight="18"/>
                </StackPanel>
                <CheckBox x:Name="DontShowAgainBox" Grid.Row="2" Content="{Binding [S0166], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                          Foreground="#E8EAF0" Margin="22,10,22,14" FontSize="12.5" FontFamily="{StaticResource CyberTechFont}"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,22,20">
                    <Button Content="{Binding [S0167], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click" FontFamily="{StaticResource CyberTechFont}" FontWeight="Bold"/>
                    <Button Content="{Binding [S0168], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource PrimaryButton}" Click="Save_Click" FontFamily="{StaticResource CyberTechFont}" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </views:ChamferBorder>
    </Grid>
</Window>
