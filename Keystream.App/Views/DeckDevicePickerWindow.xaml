<Window x:Class="Keystream.App.Views.DeckDevicePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Keystream.App.Views"
        xmlns:loc="clr-namespace:Keystream.App.Localization"
        Title="{Binding [S0169], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Height="590" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="14">
        <!-- Shadow Proxy Layer -->
        <Border CornerRadius="16" Background="#0A0C14" Margin="2">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.85" BlurRadius="18" ShadowDepth="4" Direction="315"/>
            </Border.Effect>
        </Border>

        <!-- Main Window Frame (chassis modal standar, sama seperti OBS Config) -->
        <views:ChamferBorder Chamfer="20" ClipChild="True"
                             Background="{StaticResource WindowBackgroundBrush}"
                             BorderBrush="{StaticResource ChassisMilledBevelBrush}"
                             InnerBevelBrush="{StaticResource ChassisInnerBevelBrush}"
                             BorderThickness="2.8"
                             SpecularTopHighlight="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Border Grid.Row="0" BorderBrush="#1E86E0" BorderThickness="0,0,0,1.5"
                        Background="{StaticResource HeaderBackgroundBrush}"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Height="44" Margin="18,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <views:IconView Icon="keyboard" Width="16" Height="16" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding [S0170], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="13.5" FontWeight="Bold"
                                       Foreground="#E0F2FE" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource ShellChromeButton}" HorizontalAlignment="Right"
                                Click="Close_Click" ToolTip="{Binding [S0003], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                            <TextBlock Text="&#x2715;" FontSize="11" FontFamily="{StaticResource CyberTechFont}" FontWeight="SemiBold" Foreground="#B9C1D1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body Content -->
                <StackPanel Grid.Row="1" Margin="22,16,22,14">
                    <TextBlock Text="{Binding [S0171], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                               TextWrapping="Wrap" Opacity="0.8"/>
                    <Border x:Name="WarningBanner" Background="#1E1A12" BorderBrush="#FFC65C" BorderThickness="1" CornerRadius="6"
                            Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="#FFC65C"/>
                    </Border>
                    <TextBlock x:Name="InfoText" TextWrapping="Wrap" Opacity="0.75" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="EmptyText" Text="{Binding [S0172], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                               TextWrapping="Wrap" Opacity="0.75" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <ListBox x:Name="DeviceList" Height="280" Margin="0,10,0,0"
                             SelectionChanged="DeviceList_SelectionChanged" MouseDoubleClick="DeviceList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Display}" FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#FCA5A5" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="HintText" TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0"/>
                    <!-- Tombol: gaya global aplikasi - ghost untuk sekunder, PrimaryButton biru untuk Hubungkan.
                         Style lokal PickerButton/PickerPrimaryButton dihapus (§61) karena menyimpang dari pola modal. -->
                    <Grid Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="RefreshButton" Content="{Binding [S0057], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Click="RefreshButton_Click"/>
                            <Button x:Name="WizardButton" Content="{Binding [S0173], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="8,0,0,0" Click="WizardButton_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CancelButton" Content="{Binding [S0010], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Click="CancelButton_Click"/>
                            <Button x:Name="ConnectButton" Content="{Binding [S0174], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False" Click="ConnectButton_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </views:ChamferBorder>
    </Grid>
</Window>
