<Window WindowStyle="None" x:Class="Keystream.App.Views.MouseSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Keystream.App.Views"
        xmlns:loc="clr-namespace:Keystream.App.Localization"
        Title="{Binding [S1586], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent" Foreground="#E8EAF0"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- FieldLabel TIDAK global (§44): didefinisikan lokal di window ini,
             disalin dari ProfileEditWindow. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource CyberTechFont}"/>
            <Setter Property="Foreground" Value="#6E7A8E"/>
            <Setter Property="Margin" Value="0,14,0,5"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="{StaticResource CyberTechFont}"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <!-- Shadow Proxy Layer -->
        <Border CornerRadius="16" Background="#0A0C14" Margin="2">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.85" BlurRadius="18" ShadowDepth="4" Direction="315"/>
            </Border.Effect>
        </Border>

        <!-- Main Window Frame -->
        <views:ChamferBorder Chamfer="20" ClipChild="True"
                             Background="{StaticResource WindowBackgroundBrush}"
                             BorderBrush="{StaticResource ChassisMilledBevelBrush}"
                             InnerBevelBrush="{StaticResource ChassisInnerBevelBrush}"
                             BorderThickness="2.8"
                             SpecularTopHighlight="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Border Grid.Row="0" BorderBrush="#1E86E0" BorderThickness="0,0,0,1.5"
                        Background="{StaticResource HeaderBackgroundBrush}"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Height="44" Margin="18,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <views:IconView Icon="gear" Width="16" Height="16" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding [S1586], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="13.5" FontWeight="Bold"
                                       Foreground="#E0F2FE" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource ShellChromeButton}" HorizontalAlignment="Right"
                                Click="Close_Click" ToolTip="{Binding [S0003], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                            <TextBlock Text="&#x2715;" FontSize="11" FontFamily="{StaticResource CyberTechFont}" FontWeight="SemiBold" Foreground="#B9C1D1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body Content -->
                <StackPanel Grid.Row="1" Margin="22,16,22,14">
                    <!-- Mode Persis (§108): di atas cakupan rekam; saat
                         dicentang, ScopeBox/ThresholdBox/DelayBox
                         dinonaktifkan (RefreshVerbatimState). -->
                    <CheckBox x:Name="VerbatimBox" Content="{Binding [S1624], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                              Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}" FontSize="13"
                              Checked="VerbatimBox_Checked" Unchecked="VerbatimBox_Unchecked"/>
                    <TextBlock Text="{Binding [S1625], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource HintText}"/>

                    <!-- Cakupan rekam -->
                    <TextBlock Text="{Binding [S1587], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ScopeBox" FontFamily="{StaticResource CyberTechFont}" FontSize="13">
                        <ComboBoxItem Content="{Binding [S1589], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Tag="ClicksAndMoves"/>
                        <ComboBoxItem Content="{Binding [S1588], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Tag="ClicksOnly"/>
                        <ComboBoxItem Content="{Binding [S1590], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Tag="ClicksMovesAndScroll"/>
                    </ComboBox>

                    <!-- Ambang gerak -->
                    <TextBlock Text="{Binding [S1591], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="ThresholdBox" Width="56" Height="30" TextAlignment="Center"
                                 FontFamily="{StaticResource CyberTechFont}" FontSize="12.5"/>
                        <TextBlock x:Name="ThresholdUnitLabel" Text="px" FontSize="12.5" Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding [S1592], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource HintText}"/>

                    <!-- Jeda minimum -->
                    <TextBlock Text="{Binding [S1593], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="DelayBox" Width="56" Height="30" TextAlignment="Center"
                                 FontFamily="{StaticResource CyberTechFont}" FontSize="12.5"/>
                        <TextBlock x:Name="DelayUnitLabel" Text="ms" FontSize="12.5" Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding [S1594], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource HintText}"/>

                    <!-- Koordinat -->
                    <TextBlock Text="{Binding [S1595], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <RadioButton x:Name="AbsoluteRadio" Content="{Binding [S1596], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                 Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}" FontSize="13" Padding="4,3,0,3"/>
                    <RadioButton x:Name="RelativeRadio" Content="{Binding [S1597], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                 Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}" FontSize="13" Padding="4,3,0,3"/>
                    <TextBlock Text="{Binding [S1598], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource HintText}"/>

                    <!-- Abaikan klik sendiri -->
                    <CheckBox x:Name="IgnoreSelfClicksBox" Content="{Binding [S1599], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                              Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}" FontSize="13" Margin="0,14,0,0"/>
                    <TextBlock Text="{Binding [S1600], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource HintText}"/>

                    <!-- Error inline (pola ProfileEditWindow): validasi gagal =
                         pesan di sini, modal TETAP terbuka untuk retry. -->
                    <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12" FontFamily="{StaticResource CyberTechFont}"
                               TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <TextBlock Text="{Binding [S1623], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource HintText}" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Footer Action Buttons -->
                <Border Grid.Row="2" Background="#0E121A" BorderBrush="#1C2433" BorderThickness="0,1,0,0" Padding="18,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding [S0010], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource GhostButton}" Click="Cancel_Click" Margin="0,0,8,0" Width="100"/>
                        <Button Content="{Binding [S0123], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True" Width="100"/>
                    </StackPanel>
                </Border>
            </Grid>
        </views:ChamferBorder>
    </Grid>
</Window>
