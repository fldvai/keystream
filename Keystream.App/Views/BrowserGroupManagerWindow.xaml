<Window WindowStyle="None" x:Class="Keystream.App.Views.BrowserGroupManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Keystream.App.Views"
        xmlns:loc="clr-namespace:Keystream.App.Localization"
        Width="920" Height="700" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Title="{Binding [S0124], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
        AllowsTransparency="True" Background="Transparent" Foreground="#E8EAF0"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource CyberTechFont}"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border CornerRadius="16" Background="#0A0C14" Margin="2">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.85" BlurRadius="18" ShadowDepth="4" Direction="315"/>
            </Border.Effect>
        </Border>

        <views:ChamferBorder Chamfer="20" ClipChild="True"
                             Background="{StaticResource WindowBackgroundBrush}"
                             BorderBrush="{StaticResource ChassisMilledBevelBrush}"
                             InnerBevelBrush="{StaticResource ChassisInnerBevelBrush}"
                             BorderThickness="2.8"
                             SpecularTopHighlight="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#1E86E0" BorderThickness="0,0,0,1.5"
                        Background="{StaticResource HeaderBackgroundBrush}"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Height="44" Margin="18,0,12,0">
                        <TextBlock Text="{Binding [S0125], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="13.5" FontWeight="Bold"
                                   Foreground="#E0F2FE" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ShellChromeButton}" HorizontalAlignment="Right"
                                Click="Close_Click" ToolTip="{Binding [S0003], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                            <TextBlock Text="&#x2715;" FontSize="11" FontFamily="{StaticResource CyberTechFont}" FontWeight="SemiBold" Foreground="#B9C1D1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Dua kolom (desain ulang 25 Okt 2026): kiri = daftar grup
                     saja, kanan = detail grup terpilih. Browser kustom dan
                     pindai pindah ke jendela Kelola Browser sendiri. -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#202636" BorderThickness="0,0,1,0">
                        <Grid Margin="22,16,14,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding [S0126], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource SectionTitle}"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Groups}" DisplayMemberPath="Name"
                                     SelectedItem="{Binding SelectedGroup}" Margin="0,0,0,6"/>
                            <Grid Grid.Row="2" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{Binding [S0127], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding AddGroupCommand}" Margin="0,0,4,0"/>
                                <Button Grid.Column="1" Content="{Binding [S0128], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding DeleteGroupCommand}" Margin="4,0,0,0"/>
                            </Grid>
                            <StackPanel Grid.Row="3">
                                <Button Content="{Binding [S0129], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Click="ManageBrowsers_Click" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding [S0130], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                           Opacity="0.55" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="14,16,22,14">
                        <StackPanel>
                            <TextBlock Text="{Binding [S0131], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                       Opacity="0.55" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Visibility="{Binding HasNoSelectedGroup, Converter={StaticResource BoolVis}}"/>
                            <!-- §140: TabControl selalu terlihat - tab
                                 Jendela Terlacak bersifat global dan harus
                                 tercapai tanpa grup terpilih; dua tab edit
                                 grup dinonaktifkan bila tak ada seleksi
                                 (IsEnabled HasSelectedGroup), bukan
                                 disembunyikan. Hint S0131 di atas tetap
                                 gated HasNoSelectedGroup seperti semula. -->
                            <TabControl x:Name="GroupTabControl" SelectionChanged="GroupTabControl_SelectionChanged">
                            <TabItem Header="{Binding [S0132], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" IsEnabled="{Binding HasSelectedGroup}">
                                <StackPanel>
                                <TextBlock Text="{Binding [S0133], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SelectedGroup.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Height="32" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [S0134], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ModeOptions}" DisplayMemberPath="Display"
                                          SelectedValuePath="Value" SelectedValue="{Binding SelectedGroup.Mode}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding [S0135], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SelectedGroup.DelayMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Height="32" VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding [S0084], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding GroupOpenModeOptions}" DisplayMemberPath="Display"
                                          SelectedValuePath="Value" SelectedValue="{Binding SelectedGroup.OpenMode}" Margin="0,0,0,8"/>
                                                                </StackPanel>
                            </TabItem>
                            <TabItem Header="{Binding [S0136], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" IsEnabled="{Binding HasSelectedGroup}">
                                <StackPanel><TextBlock Text="{Binding [S0137], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                <ListBox ItemsSource="{Binding SelectedGroup.Entries}" DisplayMemberPath="Display"
                                         SelectedItem="{Binding SelectedEntry}" Height="130" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0">
                                        <Button Content="{Binding [S0138], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding MoveEntryUpCommand}" Margin="0,0,8,0"/>
                                        <Button Content="{Binding [S0139], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding MoveEntryDownCommand}" Margin="0,0,8,0"/>
                                        <Button Content="{Binding [S0140], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding DeleteEntryCommand}"/>
                                    </WrapPanel>
                                    <Button Grid.Column="1" Content="{Binding [S0141], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding CheckGroupDryRunCommand}" HorizontalAlignment="Right"/>
                                </Grid>

                                <TextBlock Text="{Binding [S0142], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ManagerBrowsers}" DisplayMemberPath="Name"
                                          SelectedValuePath="ExePath" SelectedValue="{Binding ManagerBrowserExe}" Margin="0,0,0,6" Tag="{Binding [S0075], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                                <StackPanel Visibility="{Binding IsManagerDropdown, Converter={StaticResource BoolVis}}">
                                    <views:SearchablePanelPicker ItemsSource="{Binding ManagerAllProfiles}"
                                                              SelectedKey="{Binding ManagerProfileKey}"
                                                              Placeholder="{Binding [S0075], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="0,0,0,6"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsManagerCustom, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding [S0078], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding ManagerManualExe, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [S0079], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Height="32" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="{Binding [S0080], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Click="BrowseManagerManualExe_Click" Margin="6,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding [S0081], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding ManagerManualProfilePath, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [S0082], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Height="32" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="{Binding [S0080], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Click="BrowseManagerManualFolder_Click" Margin="6,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding ManagerManualProfileStatus}" Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding [S0143], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                               Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                </StackPanel>
                                <TextBlock Text="{Binding [S0085], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ManagerEntryUrl, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [S0086], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="0,0,0,6" Height="32" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [S0144], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                           Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <Button Content="{Binding [S0145], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding AddEntryCommand}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                                </StackPanel>
                            </TabItem>
                            <TabItem x:Name="TrackedWindowsTab" Header="{Binding [S1735], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                <StackPanel>
                                <TextBlock Text="{Binding TrackingStatusText}" TextWrapping="Wrap" FontSize="12.5" FontFamily="{StaticResource CyberTechFont}"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="{Binding [S0290], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding ClearBrowserTrackingCommand}" Padding="18,6" Margin="0,0,8,0"/>
                                    <Button Content="{Binding [S0291], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding CloseAllTrackedWindowsCommand}" Padding="18,6" Margin="0,0,8,0"/>
                                    <Button Content="{Binding [S1737], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding PruneDeadTrackingCommand}" Padding="18,6" Margin="0,0,8,0"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding [S0292], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                           Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding [S0293], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                                <ListBox ItemsSource="{Binding TrackedWindows}" Height="130" Margin="0,0,0,6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                                <Setter Property="Opacity" Value="0.55"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <TextBlock Grid.Column="0" Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding GroupDisplay}" VerticalAlignment="Center" Opacity="0.75" FontSize="12" Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding [S1738], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" Foreground="#FCA5A5" Margin="8,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Grid.Column="3" Content="{Binding [S1736], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="8,2,0,2" Padding="10,2"
                                                        IsEnabled="{Binding IsValid}"
                                                        Command="{Binding DataContext.FocusTrackedWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="4" Content="{Binding [S0003], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="8,2,0,2" Padding="10,2"
                                                        Command="{Binding DataContext.CloseTrackedWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="{Binding [S0294], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding RefreshTrackedWindowsCommand}" Padding="18,6" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                        <TextBlock Text="{Binding ErrorText}" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding HasErrorText, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2" Background="#0E121A" BorderBrush="#1C2433" BorderThickness="0,1,0,0" Padding="18,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding [S0010], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                        <Button Content="{Binding [S0123], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </views:ChamferBorder>
    </Grid>
</Window>
