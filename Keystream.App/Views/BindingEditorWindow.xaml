<Window WindowStyle="None" x:Class="Keystream.App.Views.BindingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Keystream.App.Views"
        xmlns:loc="clr-namespace:Keystream.App.Localization"
        Title="{Binding [S0002], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Height="660" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Closing="Window_Closing"
        AllowsTransparency="True" Background="Transparent" Foreground="#E8EAF0"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <views:NullToVisibilityConverter x:Key="NullVis"/>
        <views:FileIconImageConverter x:Key="FileIconImage"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource CyberTechFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Base" CornerRadius="5"
                                Background="#10131C"
                                BorderBrush="#222B3A"
                                BorderThickness="1,1,1,2">
                            <Border x:Name="Face" CornerRadius="4"
                                    Margin="1,1,1,1"
                                    BorderBrush="#3D4B63"
                                    BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2C374A" Offset="0.0"/>
                                        <GradientStop Color="#1A212E" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#38465D" Offset="0.0"/>
                                            <GradientStop Color="#232B3B" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#5B7093"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#181F2B" Offset="0.0"/>
                                            <GradientStop Color="#121721" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1E2430"/>
            <Setter Property="Foreground" Value="#DCE3F0"/>
            <Setter Property="FontFamily" Value="{StaticResource CyberTechFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <!-- 3D Bezel Base (Chassis Socket with Bottom Shadow) -->
                        <Border x:Name="ModBase" CornerRadius="4"
                                Background="#10131C"
                                BorderBrush="#222B3A"
                                BorderThickness="1,1,1,2">
                            <!-- 3D Keycap Face with Specular Gradient -->
                            <Border x:Name="ModFace" CornerRadius="3"
                                    Margin="1,1,1,1"
                                    BorderBrush="#3D4B63"
                                    BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2C374A" Offset="0.0"/>
                                        <GradientStop Color="#1A212E" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModFace" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#38465D" Offset="0.0"/>
                                            <GradientStop Color="#232B3B" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ModFace" Property="BorderBrush" Value="#5B7093"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModBase" Property="Background" Value="#08233C"/>
                                <Setter TargetName="ModBase" Property="BorderBrush" Value="#175084"/>
                                <Setter TargetName="ModFace" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1E86E0" Offset="0.0"/>
                                            <GradientStop Color="#115699" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ModFace" Property="BorderBrush" Value="#5BE4FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ModFace" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PickerKey" TargetType="Button">
            <Setter Property="Background" Value="#202735"/>
            <Setter Property="Foreground" Value="#E0E6F0"/>
            <Setter Property="FontFamily" Value="{StaticResource CyberTechFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,2,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Keycap Outer Chassis Base (Gives 3D depth and bottom shadow) -->
                        <Border x:Name="KeyBase" CornerRadius="4"
                                Background="#10131C"
                                BorderBrush="#222B3A"
                                BorderThickness="1,1,1,2">
                            <!-- Keycap Top Dish / Face (Elevated with subtle specular gradient) -->
                            <Border x:Name="KeyFace" CornerRadius="3"
                                    Margin="1,1,1,1"
                                    BorderBrush="#3D4B63"
                                    BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2C374A" Offset="0.0"/>
                                        <GradientStop Color="#1A212E" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeyFace" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#38465D" Offset="0.0"/>
                                            <GradientStop Color="#232B3B" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="KeyFace" Property="BorderBrush" Value="#5B7093"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KeyFace" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="KeyFace" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#181F2B" Offset="0.0"/>
                                            <GradientStop Color="#121721" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <!-- Shadow proxy layer: isolated shadow layer, prevents text blur and border artifacts -->
        <Border CornerRadius="16" Background="#0A0C14" Margin="2">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.8" BlurRadius="16" ShadowDepth="4" Direction="315"/>
            </Border.Effect>
        </Border>

        <views:ChamferBorder Chamfer="20" ClipChild="True"
                             Background="{StaticResource WindowBackgroundBrush}"
                             BorderBrush="{StaticResource ChassisMilledBevelBrush}"
                             InnerBevelBrush="{StaticResource ChassisInnerBevelBrush}"
                             BorderThickness="3.0"
                             SpecularTopHighlight="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="#1E86E0" BorderThickness="0,0,0,1.5"
                        Background="{StaticResource HeaderBackgroundBrush}"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Height="46" Margin="18,0,12,0">
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="15" FontWeight="Bold" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ShellChromeButton}" HorizontalAlignment="Right"
                                Click="Close_Click" ToolTip="{Binding [S0003], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                            <TextBlock Text="&#x2715;" FontSize="11" FontFamily="{StaticResource CyberTechFont}" FontWeight="SemiBold" Foreground="#B9C1D1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>


        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,12,20,0">
            <StackPanel Margin="0,0,6,0">
                <!-- CYBERDECK HARDWARE KEYCAP SOCKET & TELEMETRY BAY -->
                <Border Margin="0,4,0,8"
                        Background="#0D111A"
                        BorderBrush="#252F40"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="12,10">
                    <Grid>
                        <!-- NORMAL HUD STATE: Shown when not scanning for keys -->
                        <Grid Visibility="{Binding IsNotListeningForKey, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. 3D Mechanical Keycap Simulation -->
                            <Grid Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                <!-- Ambient RGB Underglow under the switch stem -->
                                <Border Width="54" Height="50" CornerRadius="10" Background="#1E86E0" Opacity="0.32" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <BlurEffect Radius="14"/>
                                    </Border.Effect>
                                </Border>
                                
                                <!-- Keycap outer bezel base (Mechanical Key Housing) -->
                                <Border Width="54" Height="48" CornerRadius="7"
                                        Background="#161B26" BorderBrush="#364357" BorderThickness="1.5,1.5,3,3">
                                    <!-- Keycap concave top face with specular highlight -->
                                    <Border Margin="2,2,3,4" CornerRadius="5"
                                            BorderBrush="#475569" BorderThickness="1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#2C374A" Offset="0"/>
                                                <GradientStop Color="#181E2B" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2">
                                            <Viewbox MaxWidth="42" MaxHeight="26" Stretch="Uniform">
                                                <TextBlock Text="{Binding KeyCapBadge}"
                                                           FontSize="17" FontWeight="Bold"
                                                           Foreground="#5BE4FF"
                                                           FontFamily="{StaticResource CyberTitleFont}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect Color="#38BDF8" BlurRadius="6" ShadowDepth="0" Opacity="0.75"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Grid>

                            <!-- 2. Hardware Telemetry Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PhysicalKeyText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"
                                               FontFamily="{StaticResource CyberTechFont}" Margin="0,0,0,3"/>
                                    <TextBlock Text="&#x26A0;" FontSize="14" FontWeight="Bold" Foreground="#FFC65C"
                                               FontFamily="{StaticResource CyberTechFont}" Margin="6,0,0,3" VerticalAlignment="Center"
                                               Visibility="{Binding HasSharedKeyWarning, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SharedKeyWarning}" TextWrapping="Wrap" Foreground="#FFC65C" FontSize="12" Margin="0,0,0,3"
                                           Visibility="{Binding HasSharedKeyWarning, Converter={StaticResource BoolVis}}"/>
                                <!-- §134 C2: aksi cepat warning duplikat (situs editor saja) - persis
                                     mencentang-off checkbox Aktif: staged, Simpan yang menulis.
                                     Collapsed bersama warning, jadi panel identik saat warning hilang. -->
                                <Button Style="{StaticResource GhostButton}" Height="26" Padding="12,2" Margin="0,1,0,3"
                                        HorizontalAlignment="Left"
                                        Command="{Binding DeactivateCardCommand}"
                                        Visibility="{Binding HasSharedKeyWarning, Converter={StaticResource BoolVis}}"
                                        Content="{Binding [S1715], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                        FontSize="11" FontFamily="{StaticResource CyberTechFont}"/>
                                <TextBlock Text="{Binding DeckHardwareStatusText}" FontSize="11" Foreground="#8A93A5"
                                           FontFamily="{StaticResource CyberTechFont}"/>
                            </StackPanel>

                            <!-- 3. Trigger / Ganti Tombol Button -->
                            <Button Grid.Column="2" VerticalAlignment="Center"
                                    Style="{StaticResource PillButton}"
                                    Command="{Binding StartReassignCommand}"
                                    Padding="13,5" Height="32"
                                    ToolTip="{Binding [S0005], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#x27F3;" FontSize="13" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [S0007], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- CALIBRATION / RADAR SCANNING STATE: Shown when listening for new key -->
                        <Border Visibility="{Binding IsListeningForKey, Converter={StaticResource BoolVis}}"
                                Background="#0A1626" BorderBrush="#1E86E0" BorderThickness="1.5" CornerRadius="6"
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Animated Radar Scan Ring -->
                                <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="#1E86E0" StrokeThickness="2.5" StrokeDashArray="14,6"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="ReassignSpin"/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ReassignSpin" Storyboard.TargetProperty="Angle"
                                                                         From="0" To="360" Duration="0:0:1.0" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <views:IconView Icon="keyboard" Width="16" Height="16" Foreground="#5BE4FF"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [S0008], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="13" FontWeight="Bold"
                                               Foreground="#5BE4FF" FontFamily="{StaticResource CyberTechFont}"/>
                                    <TextBlock Text="{Binding [S0009], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                               FontSize="10.5" Foreground="#94A3B8" FontFamily="{StaticResource CyberTechFont}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="{Binding [S0010], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource GhostButton}"
                                        Command="{Binding CancelReassignCommand}"
                                        Padding="16,6" Height="30" VerticalAlignment="Center"
                                        FontFamily="{StaticResource CyberTechFont}" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- §155: checkbox Kartu aktif pindah ke sini - kanan atas,
                     sejajar label Nama tampilan. Template + binding sama
                     persis dengan blok §132 yang dihapus di bawah trigger
                     (staged flag, Simpan yang menulis); hanya posisi pindah. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding [S0011], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding IsCardActive}" Margin="0,12,0,4"
                              FontFamily="{StaticResource CyberTechFont}" FontSize="12.5" Foreground="#E8EAF0"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Content="{Binding [S1703], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                            Background="#1E222D" BorderBrush="#3A4152" BorderThickness="1">
                                        <Path x:Name="Check" Data="M 3,8 L 6.5,11.5 L 13,4.5" Stroke="#FFFFFF" StrokeThickness="2"
                                              Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                               Text="{TemplateBinding Content}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontSize="{TemplateBinding FontSize}"
                                               Foreground="{TemplateBinding Foreground}"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Box" Property="Background" Value="#1E86E0"/>
                                        <Setter TargetName="Box" Property="BorderBrush" Value="#1E86E0"/>
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Box" Property="BorderBrush" Value="#1E86E0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>
                </Grid>
                <TextBox Text="{Binding Label}"/>

                <TextBlock Text="{Binding [S0012], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding ActionOptions}" DisplayMemberPath="Display"
                          SelectedValuePath="ActionId" SelectedValue="{Binding SelectedActionId}"/>

                <!-- hotkey -->
                <StackPanel Visibility="{Binding IsHotkey, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding [S0013], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding HotkeyText}" FontSize="14"/>
                    <Border Background="#14161C" BorderBrush="#262B36" BorderThickness="1" CornerRadius="8"
                            Padding="8,8,4,4" Margin="0,8,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <ToggleButton Content="Ctrl" Width="72" Style="{StaticResource ModToggle}" IsChecked="{Binding ModCtrl}" Margin="0,0,4,0"/>
                                <ToggleButton Content="Shift" Width="72" Style="{StaticResource ModToggle}" IsChecked="{Binding ModShift}" Margin="0,0,4,0"/>
                                <ToggleButton Content="Alt" Width="72" Style="{StaticResource ModToggle}" IsChecked="{Binding ModAlt}" Margin="0,0,4,0"/>
                                <ToggleButton Content="Win" Width="72" Style="{StaticResource ModToggle}" IsChecked="{Binding ModWin}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding [S0018], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                       FontSize="10.5" Opacity="0.5" Margin="0,4,0,6"/>
                            <ItemsControl ItemsSource="{Binding PickerFunctionKeys}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="12"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Style="{StaticResource PickerKey}" FontSize="11.5"
                                                Command="{Binding DataContext.PickVirtualKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding PickerRowNumbers}" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="14"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Display}" Style="{StaticResource PickerKey}" MinWidth="30" Padding="2,0" FontSize="11"
                                                Command="{Binding DataContext.PickVirtualKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Value}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding PickerRowTop}" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="14"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Display}" Style="{StaticResource PickerKey}" MinWidth="30" Padding="2,0" FontSize="11"
                                                Command="{Binding DataContext.PickVirtualKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Value}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2.6*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Caps" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="CapsLock"/>
                                <Button Grid.Column="1" Content="A" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="A"/>
                                <Button Grid.Column="2" Content="S" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="S"/>
                                <Button Grid.Column="3" Content="D" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="D"/>
                                <Button Grid.Column="4" Content="F" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="F"/>
                                <Button Grid.Column="5" Content="G" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="G"/>
                                <Button Grid.Column="6" Content="H" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="H"/>
                                <Button Grid.Column="7" Content="J" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="J"/>
                                <Button Grid.Column="8" Content="K" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="K"/>
                                <Button Grid.Column="9" Content="L" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="L"/>
                                <Button Grid.Column="10" Content=";" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="Semicolon"/>
                                <Button Grid.Column="11" Content="'" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="Apostrophe"/>
                                <Button Grid.Column="12" Content="Enter" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="Enter"/>
                            </Grid>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="1.8*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Z" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="Z"/>
                                <Button Grid.Column="1" Content="X" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="X"/>
                                <Button Grid.Column="2" Content="C" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="C"/>
                                <Button Grid.Column="3" Content="V" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="V"/>
                                <Button Grid.Column="4" Content="B" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="B"/>
                                <Button Grid.Column="5" Content="N" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="N"/>
                                <Button Grid.Column="6" Content="M" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="M"/>
                                <Button Grid.Column="7" Content="," Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="Comma"/>
                                <Button Grid.Column="8" Content="." Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="Period"/>
                                <Button Grid.Column="9" Content="/" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="Slash"/>
                                <Button Grid.Column="10" Content="Space" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="Space"/>
                                <Button Grid.Column="11" Content="Menu" Style="{StaticResource PickerKey}" FontSize="11"
                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="Menu"/>
                            </Grid>
                            <TextBlock Text="{Binding [S0044], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Opacity="0.5" Margin="0,6,0,3"/>
                            <ItemsControl ItemsSource="{Binding PickerNavKeys}" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="13"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Display}" Style="{StaticResource PickerKey}" MinWidth="30" Padding="2,0" FontSize="11"
                                                Command="{Binding DataContext.PickVirtualKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Value}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding [S0045], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Opacity="0.5" Margin="0,6,0,3"/>
                            <ItemsControl ItemsSource="{Binding PickerNumpadKeys}" Width="192" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Display}" Style="{StaticResource PickerKey}" FontSize="11.5"
                                                Command="{Binding DataContext.PickVirtualKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Value}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Num 0" Style="{StaticResource PickerKey}" Width="190" HorizontalAlignment="Left"
                                    Command="{Binding PickVirtualKeyCommand}" CommandParameter="Numpad0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- media -->
                <StackPanel Visibility="{Binding IsMedia, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding [S0047], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding MediaOptions}" DisplayMemberPath="Display"
                              SelectedValuePath="Value" SelectedValue="{Binding MediaValue}"/>
                    <TextBlock Text="{Binding [S0048], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                               Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- launcher: Buka Aplikasi -->
                <StackPanel Visibility="{Binding IsLauncher, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding [S0049], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Path TextBox -->
                        <TextBox Grid.Column="0" Text="{Binding LauncherTarget, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{Binding [S0050], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                 Height="32" VerticalAlignment="Center"/>

                        <!-- Tombol Cari File (Gambar 2: Folder Icon) -->
                        <Button Grid.Column="1" Width="36" Height="32" Margin="6,0,0,0" Padding="0"
                                Click="BrowseLauncher_Click" ToolTip="{Binding [S0051], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                            <views:IconView Icon="folder" Width="15" Height="15" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Tombol Apps (Gambar 2: [Apps]) -->
                        <ToggleButton Grid.Column="2" Style="{StaticResource ModToggle}"
                                      IsChecked="{Binding IsAppDrawerOpen}"
                                      Height="32" Padding="10,0" Margin="6,0,0,0"
                                      ToolTip="{Binding [S0052], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <views:IconView Icon="apps" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                                <TextBlock Text="{Binding [S0053], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" FontFamily="{StaticResource CyberTechFont}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                    </Grid>

                    <!-- Laci Aplikasi (App Drawer - Gambar 3) -->
                    <Border Visibility="{Binding IsAppDrawerOpen, Converter={StaticResource BoolVis}}"
                            Background="#0E121B" BorderBrush="#232E42" BorderThickness="1.2" CornerRadius="8"
                            Padding="8" Margin="0,4,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Drawer Search Bar & Refresh -->
                            <Grid Grid.Row="0" Margin="2,2,2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding AppDrawerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="{Binding [S0054], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                         Height="28" FontSize="11.5" Padding="6,2"
                                         ToolTip="{Binding [S0055], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                                <Button Grid.Column="1" Height="28" Padding="10,0" Margin="6,0,0,0"
                                        Command="{Binding RefreshAppDrawerCommand}" ToolTip="{Binding [S0056], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <views:IconView Icon="refresh" Width="11" Height="11" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding [S0057], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="11" FontFamily="{StaticResource CyberTechFont}" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Loading progress line -->
                            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" Margin="2,0,2,4"
                                         Visibility="{Binding IsLoadingApps, Converter={StaticResource BoolVis}}"/>

                            <!-- App List (Format Gambar 3: Icon + Bold Name + Muted Path) -->
                            <ListBox Grid.Row="2" ItemsSource="{Binding FilteredAppDrawerItems}"
                                     Height="196" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,3" Cursor="Hand">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- App Icon -->
                                            <Border Grid.Column="0" Width="26" Height="26" Background="#161B26" BorderBrush="#252F42" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Grid>
                                                    <views:IconView Icon="apps" Width="14" Height="14" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="{Binding Icon, Converter={StaticResource NullVis}}"/>
                                                </Grid>
                                            </Border>

                                            <!-- App Name & Path -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#F1F5F9" FontFamily="{StaticResource CyberTechFont}"/>
                                                <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#64748B" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#1C2536"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="AppDrawerItem_Click"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <!-- Empty-state laci (§45): keterangan saat daftar kosong. -->
                            <TextBlock Grid.Row="3" Text="{Binding AppDrawerEmptyText}" TextWrapping="Wrap"
                                       Margin="2,6,2,2" Foreground="#94A3B8" FontSize="11.5"
                                       FontFamily="{StaticResource CyberTechFont}"
                                       Visibility="{Binding HasAppDrawerEmptyText, Converter={StaticResource BoolVis}}"/>
                        </Grid>
                    </Border>

                    <!-- Status fetch ikon launcher: sebelumnya hanya ada di
                         panel link, jadi gagal fetch launcher tidak terlihat. -->
                    <TextBlock Text="{Binding IconFetchStatus}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding HasIconFetchStatus, Converter={StaticResource BoolVis}}"/>
                </StackPanel>

                <!-- link: Buka Link -->
                <StackPanel Visibility="{Binding IsLink, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding [S0059], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding LinkUrl}" FontSize="13"/>
                    <TextBlock Text="{Binding [S0060], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                               Opacity="0.55" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding IconFetchStatus}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding HasIconFetchStatus, Converter={StaticResource BoolVis}}"/>
                </StackPanel>

                <!-- obs -->
                <StackPanel Visibility="{Binding IsObs, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding [S0061], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding ObsOptions}" DisplayMemberPath="Display"
                              SelectedValuePath="Value" SelectedValue="{Binding ObsCommandValue}"/>
                    <StackPanel Visibility="{Binding ObsNeedsName, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding ObsNameLabel}" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <Button Content="↻" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2"
                                    Command="{Binding RefreshObsNamesCommand}" ToolTip="{Binding [S0063], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                            <ComboBox IsEditable="True" ItemsSource="{Binding ObsNameOptions}"
                                      Text="{Binding ObsNameText, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding ObsListHint}" Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding ObsNeedsName2, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding ObsName2Label}" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <Button Content="↻" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2"
                                    Command="{Binding RefreshObsNames2Command}" ToolTip="{Binding [S0063], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                            <ComboBox IsEditable="True" ItemsSource="{Binding ObsName2Options}"
                                      Text="{Binding ObsName2Text, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding ObsList2Hint}" Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding ObsNeedsValue, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding ObsValueLabel}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ObsValueText}"/>
                        <TextBlock Text="{Binding ObsValueHint}" Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding [S0064], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Opacity="0.55" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- streamerbot -->
                <StackPanel Visibility="{Binding IsStreamerBot, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding [S1753], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                        <Button Content="↻" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2"
                                Command="{Binding RefreshStreamerBotActionsCommand}" ToolTip="{Binding [S0063], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                        <ComboBox IsEditable="True" ItemsSource="{Binding StreamerBotActionOptions}"
                                  Text="{Binding StreamerBotActionText, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding StreamerBotDiscoveryHint}" Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding [S1754], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding StreamerBotArgsText}"/>
                </StackPanel>

                <!-- steam -->
                <StackPanel Visibility="{Binding IsSteam, Converter={StaticResource BoolVis}}">
                    <!-- Warning jika Steam belum terpasang -->
                    <Border Visibility="{Binding IsSteamNotInstalled, Converter={StaticResource BoolVis}}"
                            Background="#3B1C1C" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="6"
                            Padding="10,8" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <views:IconView Icon="flag" Width="15" Height="15" Foreground="#F87171" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding [S1855], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                       Foreground="#FCA5A5" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding [S1850], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding SteamCommands}" DisplayMemberPath="Display"
                              SelectedValuePath="Value" SelectedValue="{Binding SteamCommandValue}"/>

                    <!-- Jalankan Game: Pemilih Game -->
                    <StackPanel Visibility="{Binding IsSteamGame, Converter={StaticResource BoolVis}}" Margin="0,10,0,0">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [S1851], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Width="28" Height="24" Padding="0"
                                    Command="{Binding RefreshSteamGamesCommand}" ToolTip="{Binding [S1872], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                <views:IconView Icon="refresh" Width="12" Height="12" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <ComboBox ItemsSource="{Binding SteamGameOptions}" DisplayMemberPath="Display"
                                  SelectedValuePath="AppId" SelectedValue="{Binding SteamAppId}"
                                  Tag="{Binding [S1851], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                        <TextBlock Text="{Binding SteamGameSummaryText}" Opacity="0.55" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Mode Big Picture: Pilihan Aksi (Toggle, Masuk, Keluar) -->
                    <StackPanel Visibility="{Binding IsSteamBigPicture, Converter={StaticResource BoolVis}}" Margin="0,10,0,0">
                        <TextBlock Text="{Binding [S1882], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding SteamBigPictureOptions}" DisplayMemberPath="Display"
                                  SelectedValuePath="Value" SelectedValue="{Binding SteamBigPictureMode}"/>
                    </StackPanel>

                    <!-- Ubah Status: Pilihan Status -->
                    <StackPanel Visibility="{Binding IsSteamStatus, Converter={StaticResource BoolVis}}" Margin="0,10,0,0">
                        <TextBlock Text="{Binding [S1867], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding SteamStatuses}" DisplayMemberPath="Display"
                                  SelectedValuePath="Value" SelectedValue="{Binding SteamStatusValue}"/>
                    </StackPanel>

                    <!-- Checkbox Mode Toggle (Tampil untuk perintah yang relevan: launch, status, downloads, friends) -->
                    <Border Visibility="{Binding SteamShowTogglePanel, Converter={StaticResource BoolVis}}"
                            Background="#121722" BorderBrush="#232E42" BorderThickness="1" CornerRadius="6"
                            Padding="10,8" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [S1856], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                           FontWeight="SemiBold" FontSize="12" Foreground="#F1F5F9"/>
                                <TextBlock Text="{Binding SteamToggleHintText}" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding SteamIsToggle}" VerticalAlignment="Center" Margin="8,0,0,0">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                                Background="#1E222D" BorderBrush="#3A4152" BorderThickness="1">
                                            <Path x:Name="Check" Data="M 3,8 L 6.5,11.5 L 13,4.5" Stroke="#FFFFFF" StrokeThickness="2"
                                                  Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                             <Trigger Property="IsChecked" Value="True">
                                                 <Setter TargetName="Box" Property="Background" Value="#1E86E0"/>
                                                 <Setter TargetName="Box" Property="BorderBrush" Value="#1E86E0"/>
                                                 <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                             </Trigger>
                                             <Trigger Property="IsMouseOver" Value="True">
                                                 <Setter TargetName="Box" Property="BorderBrush" Value="#1E86E0"/>
                                             </Trigger>
                                         </ControlTemplate.Triggers>
                                     </ControlTemplate>
                                 </CheckBox.Template>
                             </CheckBox>
                         </Grid>
                     </Border>

                     <!-- Pilihan saat game sedang berjalan (DI BAWAH panel toggle mode) -->
                     <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowSteamRunningGameOptions, Converter={StaticResource BoolVis}}">
                         <TextBlock Text="{Binding [S1873], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                         <ComboBox ItemsSource="{Binding SteamRunningGameActions}" DisplayMemberPath="Display"
                                   SelectedValuePath="Value" SelectedValue="{Binding SteamRunningGameAction}"/>
                     </StackPanel>

                     <!-- Status Profil Kedua (DI BAWAH panel toggle mode) -->
                     <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowSteamSecondStatusOptions, Converter={StaticResource BoolVis}}">
                         <TextBlock Text="{Binding [S1861], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                         <ComboBox ItemsSource="{Binding SteamStatuses}" DisplayMemberPath="Display"
                                   SelectedValuePath="Value" SelectedValue="{Binding SteamStatusSecondValue}"/>
                     </StackPanel>
                </StackPanel>

                <!-- sound -->
                <StackPanel Visibility="{Binding IsSound, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding [S0065], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding SoundFile}" Width="330"/>
                        <Button Content="{Binding [S0066], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="8,0,0,0" Padding="10,4" Click="BrowseSound_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- deck: ganti mode -->
                <StackPanel Visibility="{Binding IsDeck, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding [S0067], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding DeckOptions}" DisplayMemberPath="Display"
                              SelectedValuePath="Value" SelectedValue="{Binding DeckCommandValue}"/>
                    <StackPanel Visibility="{Binding DeckNeedsPage, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding [S0068], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding DeckPageOptions}" DisplayMemberPath="Display"
                                  SelectedValuePath="Value" SelectedValue="{Binding DeckPageId}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding [S0069], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                               Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsBasic, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding [S0070], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding BasicOptions}" DisplayMemberPath="Display"
                              SelectedValuePath="Value" SelectedValue="{Binding BasicValue}"/>
                    <TextBlock Text="{Binding [S0071], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                               Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsWindows, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding [S0072], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <!-- §126: pemilih Windows Commands yang bisa dicari -
                         SearchablePanelPicker yang SAMA dengan pemilih
                         profil Browser (kotak "Type to filter..." S0255
                         + tombol × dari template global TextBox, panel
                         di tempat, tutup via pilih/Esc/klik-di-luar).
                         EscapeClearsFilterFirst="True": Esc pertama
                         membersihkan filter, Esc kedua menutup panel.
                         UseWordAndFilter="True": filter AND-per-kata +
                         keyword target (gpedit/msconfig); pemilih
                         profil Browser tetap frasa literal (§A).
                         Daftar flat, tanpa kategori/chip: urutan
                         katalog dipertahankan, filter hanya
                         menyembunyikan yang tak cocok. -->
                    <!-- §129: sumber katalog mengikuti type yang dipilih -
                         partisi Windows Command / Windows Tools untuk
                         type baru, gabungan 94 untuk kartu lama
                         "windows" (CurrentWindowsOptions). Picker
                         pencariannya sama. -->
                    <views:SearchablePanelPicker ItemsSource="{Binding CurrentWindowsOptions}"
                                                  SelectedKey="{Binding WindowsValue}"
                                                  EscapeClearsFilterFirst="True"
                                                  UseWordAndFilter="True"/>
                    <TextBlock Text="{Binding [S0073], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                               Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsBrowser, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding [S0074], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding BrowserOptions}" DisplayMemberPath="Display"
                                  SelectedValuePath="ExePath" SelectedValue="{Binding BrowserExe}" Tag="{Binding [S0075], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                        <Button Grid.Column="1" Content="{Binding PindaiButtonText}" Click="PindaiBrowser_Click" Margin="6,0,0,0"/>
                    </Grid>
                    <StackPanel Visibility="{Binding IsBrowserDropdown, Converter={StaticResource BoolVis}}">
                        <!-- Label kiri, checkbox multi kanan, satu baris
                             (25 Okt 2026). Margin baris = margin label
                             lama (0,12,0,4); Margin label di-nol-kan
                             lokal agar tidak dobel. -->
                        <Grid Margin="0,12,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [S0076], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                            <!-- Toggle multi (25 Okt 2026): sama seperti
                                 baris profil - TEKS DULU, kotak
                                 belakangan, kotak digambar sendiri
                                 untuk tema gelap (bukan kotak putih
                                 + centang hitam bawaan WPF). -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [S0077], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Foreground="#E8EAF0" VerticalAlignment="Center"/>
                                <CheckBox IsChecked="{Binding BrowserProfileMulti}" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                                    Background="#1E222D" BorderBrush="#3A4152" BorderThickness="1">
                                                <Path x:Name="Check" Data="M 3,8 L 6.5,11.5 L 13,4.5" Stroke="#FFFFFF" StrokeThickness="2"
                                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Box" Property="Background" Value="#1E86E0"/>
                                                    <Setter TargetName="Box" Property="BorderBrush" Value="#1E86E0"/>
                                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Box" Property="BorderBrush" Value="#1E86E0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>
                            </StackPanel>
                        </Grid>
                        <views:SearchablePanelPicker ItemsSource="{Binding BrowserProfiles}"
                                                  SelectedKey="{Binding BrowserProfileKey}"
                                                  IsMultiSelect="{Binding BrowserProfileMulti}"
                                                  CheckedKeys="{Binding BrowserProfileKeys}"
                                                  Placeholder="{Binding BrowserProfilePlaceholder}"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsBrowserCustom, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding [S0078], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ManualBrowserExe, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [S0079], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                            <Button Grid.Column="1" Content="{Binding [S0080], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Click="BrowseManualExe_Click" Margin="6,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding [S0081], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ManualProfilePath, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [S0082], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                            <Button Grid.Column="1" Content="{Binding [S0080], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Click="BrowseManualFolder_Click" Margin="6,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding ManualProfileStatus}" Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding [S0083], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                   Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding [S0084], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding BrowserOpenModeOptions}" DisplayMemberPath="Display"
                              SelectedValuePath="Value" SelectedValue="{Binding BrowserOpenMode}"/>
                    <TextBlock Text="{Binding [S0085], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding BrowserUrl, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [S0086], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                             Height="32" VerticalAlignment="Center"/>
                    <Button Content="{Binding [S0087], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding ForgetTrackedBrowserCommand}"
                            Visibility="{Binding HasTrackedBrowserWindow, Converter={StaticResource BoolVis}}"
                            ToolTip="{Binding [S0088], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                            HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding [S0089], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                               Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <!-- Status fetch ikon browser (§95): sebelumnya hanya ada
                         di panel link, jadi gagal fetch browser tidak terlihat. -->
                    <TextBlock Text="{Binding IconFetchStatus}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding HasIconFetchStatus, Converter={StaticResource BoolVis}}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsBrowserGroup, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding [S0090], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding BrowserGroupOptions}" DisplayMemberPath="Display"
                                  SelectedValuePath="Value" SelectedValue="{Binding BrowserGroupId}"/>
                        <Button Grid.Column="1" Content="{Binding [S0091], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding ManageBrowserGroupsCommand}" Margin="6,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding [S0092], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                               Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <!-- Status fetch ikon komposit grup (§95): sama, sebelumnya
                         tidak terikat ke UI apa pun. -->
                    <TextBlock Text="{Binding IconFetchStatus}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding HasIconFetchStatus, Converter={StaticResource BoolVis}}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsMacro, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding [S0093], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding MacroOptions}" DisplayMemberPath="Display"
                                  SelectedValuePath="Value" SelectedValue="{Binding MacroId}"/>
                        <Button Grid.Column="1" Content="{Binding [S0094], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding ManageMacrosCommand}" Margin="6,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding [S0095], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                               Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsProfile, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding [S0096], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding ProfileOptions}" DisplayMemberPath="Display"
                              SelectedValuePath="Value" SelectedValue="{Binding ProfileId}"/>
                    <TextBlock Text="{Binding [S0097], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                               Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <TextBlock Text="{Binding [S0098], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                <!-- §155: tooltip per item (hover baris dropdown) + tooltip
                     combo tertutup + teks tetap di bawah, satu sumber:
                     ValueOption.Hint / TriggerHint. ItemContainerStyle
                     BasedOn gaya ComboBoxItem global App.xaml agar
                     template gelap dropdown tidak hilang. -->
                <ComboBox ItemsSource="{Binding TriggerOptions}" DisplayMemberPath="Display"
                          SelectedValuePath="Value" SelectedValue="{Binding SelectedTrigger}"
                          ToolTip="{Binding TriggerHint}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                            <Setter Property="ToolTip" Value="{Binding Hint}"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <TextBlock Text="{Binding TriggerHint}" TextWrapping="Wrap"
                           Opacity="0.55" FontSize="11" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding TriggerAutoNote}" TextWrapping="Wrap" Opacity="0.6" FontSize="11" Margin="0,4,0,0"
                           Visibility="{Binding HasTriggerAutoNote, Converter={StaticResource BoolVis}}"/>

                <!-- ============================================== -->
                <!-- FITUR KOMBINASI (COMBINATIONS - GAMBAR 4)     -->
                <!-- ============================================== -->
                <Border Margin="0,16,0,12" Background="#161B26" BorderBrush="#253043" BorderThickness="1.2" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <!-- Header & Add Button -->
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Height="28" Padding="12,0"
                                    Command="{Binding AddCombinationCommand}"
                                    ToolTip="{Binding [S0099], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="+" FontSize="13" FontWeight="Bold" Margin="0,0,5,0" Foreground="#5BE4FF" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [S0101], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource CyberTechFont}" Foreground="#E0E6F0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <views:IconView Icon="keyboard" Width="14" Height="14" Foreground="#5BE4FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [S0102], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" FontFamily="{StaticResource CyberTechFont}" Foreground="#5BE4FF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Dynamic description matching Gambar 4 -->
                        <TextBlock Text="{Binding CombinationPromptText}"
                                   FontSize="11" Foreground="#94A3B8" FontFamily="{StaticResource CyberTechFont}"
                                   TextWrapping="Wrap" Margin="0,2,0,8"/>

                        <!-- Combinations List -->
                        <ItemsControl ItemsSource="{Binding Combinations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1D2433" BorderBrush="#2D3A50" BorderThickness="1" CornerRadius="6"
                                            Padding="10,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Key Badge + Second Key capture + Delete button -->
                                            <DockPanel Grid.Row="0">
                                                <Button Style="{StaticResource XButtonStyle}" DockPanel.Dock="Right" Width="26" Height="26" Padding="0" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.DeleteCombinationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" ToolTip="{Binding [S0103], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                                    <TextBlock Text="&#x2715;" FontSize="11" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- First Key (Parent) -->
                                                    <Border CornerRadius="4" Background="#1B2230" BorderBrush="#334155" BorderThickness="1" Padding="7,3">
                                                        <TextBlock Text="{Binding DataContext.PhysicalKeyText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   FontSize="11" FontWeight="Bold" Foreground="#38BDF8" FontFamily="{StaticResource CyberTechFont}"/>
                                                    </Border>

                                                    <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="#64748B" Margin="6,0,6,0" VerticalAlignment="Center"/>

                                                    <!-- Second Key Button -->
                                                    <Button Height="26" Padding="8,0"
                                                            Command="{Binding DataContext.StartCaptureSecondKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{Binding [S0104], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <views:IconView Icon="keyboard" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#5BE4FF"/>
                                                            <TextBlock Text="{Binding SecondKeyName}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource CyberTechFont}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsListeningForSecondKey}" Value="True">
                                                                                <Setter Property="Foreground" Value="#38BDF8"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- §158 Row 1: daftar langkah (multi-langkah). Baris 0
                                                 (capture) dan Baris 2 (Label) di bawah tidak diubah. -->
                                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                                <ItemsControl ItemsSource="{Binding Steps}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#161B26" BorderBrush="#253043" BorderThickness="1" CornerRadius="6"
                                                                    Padding="8" Margin="0,0,0,6">
                                                                <StackPanel>
                                                                    <!-- Pemilih aksi langkah: bentuk yang sama dengan
                                                                         pemilih utama (:441-442), DataContext-nya
                                                                         ComboStepViewModel. -->
                                                                    <DockPanel>
                                                                        <Button Style="{StaticResource XButtonStyle}" DockPanel.Dock="Right" Width="26" Height="26" Padding="0" Margin="6,0,0,0"
                                                                                Command="{Binding DeleteStepCommand}" CommandParameter="{Binding}"
                                                                                ToolTip="{Binding [S0198], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                                                            <TextBlock Text="&#x2715;" FontSize="11" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Button>
                                                                        <ComboBox ItemsSource="{Binding ActionOptions}" DisplayMemberPath="Display"
                                                                                  SelectedValuePath="ActionId" SelectedValue="{Binding SelectedActionId}"/>
                                                                    </DockPanel>

                                                                    <!-- §158: blok di bawah ini MENCERMINKAN seksi
                                                                         parameter editor utama di
                                                                         BindingEditorWindow.xaml:445-1030
                                                                         (satu StackPanel per keluarga aksi, digerbang
                                                                         IsHotkey/IsMedia/IsLauncher/IsLink/IsObs/
                                                                         IsStreamerBot/IsSound/IsDeck/IsBasic/
                                                                         IsWindows/IsBrowser/IsBrowserGroup/IsMacro/
                                                                         IsProfile dengan BoolVis). Kontrol, urutan,
                                                                         label, converter, margin/padding disalin
                                                                         dari seksi sumber; yang berubah HANYA
                                                                         sumber binding-nya (step VM, bukan VM utama)
                                                                         §159: seluruh kontrol seksi utama dicerminkan di sini;
                                                                         lihat komentar §159 per seksi. KEDUA BLOK
                                                                         HARUS DIJAGA SINKRON: perubahan field di
                                                                         seksi utama harus dicerminkan di sini, dan
                                                                         sebaliknya, sampai ada template bersama.
                                                                         Daftar opsi memakai nama permukaan kontrak
                                                                         ComboStepViewModel (alias MediaCommands,
                                                                         BasicCommands, DeckCommands, ObsCommands
                                                                         atas data yang sama; CurrentWindowsOptions
                                                                         langsung, partisi menurut SelectedActionId
                                                                         seperti seksi utama). -->

                                                                    <!-- hotkey -->
                                                                    <StackPanel Visibility="{Binding IsHotkey, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock Text="{Binding [S0013], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                        <TextBox Text="{Binding HotkeyText}" FontSize="14"/>
                                                                        <!-- §159: papan tombol pemilih dicerminkan dari seksi utama
                                                                             (G-01–G-03); DataTemplate memakai AncestorType=ItemsControl
                                                                             agar command mengikat ke VM langkah, bukan VM utama. -->
                                                                        <Border Background="#14161C" BorderBrush="#262B36" BorderThickness="1" CornerRadius="8"
                                                                                Padding="8,8,4,4" Margin="0,8,0,0">
                                                                            <StackPanel>
                                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                                    <ToggleButton Content="Ctrl" Width="72" Style="{StaticResource ModToggle}" IsChecked="{Binding ModCtrl}" Margin="0,0,4,0"/>
                                                                                    <ToggleButton Content="Shift" Width="72" Style="{StaticResource ModToggle}" IsChecked="{Binding ModShift}" Margin="0,0,4,0"/>
                                                                                    <ToggleButton Content="Alt" Width="72" Style="{StaticResource ModToggle}" IsChecked="{Binding ModAlt}" Margin="0,0,4,0"/>
                                                                                    <ToggleButton Content="Win" Width="72" Style="{StaticResource ModToggle}" IsChecked="{Binding ModWin}"/>
                                                                                </StackPanel>
                                                                                <TextBlock Text="{Binding [S0018], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                                                                           FontSize="10.5" Opacity="0.5" Margin="0,4,0,6"/>
                                                                                <ItemsControl ItemsSource="{Binding PickerFunctionKeys}">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate><UniformGrid Columns="12"/></ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Button Content="{Binding}" Style="{StaticResource PickerKey}" FontSize="11.5"
                                                                                                    Command="{Binding DataContext.PickVirtualKeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                    CommandParameter="{Binding}"/>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <ItemsControl ItemsSource="{Binding PickerRowNumbers}" Margin="0,2,0,0">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate><UniformGrid Columns="14"/></ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Button Content="{Binding Display}" Style="{StaticResource PickerKey}" MinWidth="30" Padding="2,0" FontSize="11"
                                                                                                    Command="{Binding DataContext.PickVirtualKeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                    CommandParameter="{Binding Value}"/>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <ItemsControl ItemsSource="{Binding PickerRowTop}" Margin="0,2,0,0">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate><UniformGrid Columns="14"/></ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Button Content="{Binding Display}" Style="{StaticResource PickerKey}" MinWidth="30" Padding="2,0" FontSize="11"
                                                                                                    Command="{Binding DataContext.PickVirtualKeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                    CommandParameter="{Binding Value}"/>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <Grid Margin="0,2,0,0">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="1.5*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="2.6*"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Button Grid.Column="0" Content="Caps" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="CapsLock"/>
                                                                                    <Button Grid.Column="1" Content="A" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="A"/>
                                                                                    <Button Grid.Column="2" Content="S" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="S"/>
                                                                                    <Button Grid.Column="3" Content="D" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="D"/>
                                                                                    <Button Grid.Column="4" Content="F" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="F"/>
                                                                                    <Button Grid.Column="5" Content="G" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="G"/>
                                                                                    <Button Grid.Column="6" Content="H" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="H"/>
                                                                                    <Button Grid.Column="7" Content="J" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="J"/>
                                                                                    <Button Grid.Column="8" Content="K" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="K"/>
                                                                                    <Button Grid.Column="9" Content="L" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="L"/>
                                                                                    <Button Grid.Column="10" Content=";" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="Semicolon"/>
                                                                                    <Button Grid.Column="11" Content="'" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="Apostrophe"/>
                                                                                    <Button Grid.Column="12" Content="Enter" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="Enter"/>
                                                                                </Grid>
                                                                                <Grid Margin="0,2,0,0">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="3*"/>
                                                                                        <ColumnDefinition Width="1.8*"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Button Grid.Column="0" Content="Z" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="Z"/>
                                                                                    <Button Grid.Column="1" Content="X" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="X"/>
                                                                                    <Button Grid.Column="2" Content="C" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="C"/>
                                                                                    <Button Grid.Column="3" Content="V" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="V"/>
                                                                                    <Button Grid.Column="4" Content="B" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="B"/>
                                                                                    <Button Grid.Column="5" Content="N" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="N"/>
                                                                                    <Button Grid.Column="6" Content="M" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="M"/>
                                                                                    <Button Grid.Column="7" Content="," Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="Comma"/>
                                                                                    <Button Grid.Column="8" Content="." Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="Period"/>
                                                                                    <Button Grid.Column="9" Content="/" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="Slash"/>
                                                                                    <Button Grid.Column="10" Content="Space" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="Space"/>
                                                                                    <Button Grid.Column="11" Content="Menu" Style="{StaticResource PickerKey}" FontSize="11"
                                                                                            Command="{Binding PickVirtualKeyCommand}" CommandParameter="Menu"/>
                                                                                </Grid>
                                                                                <TextBlock Text="{Binding [S0044], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Opacity="0.5" Margin="0,6,0,3"/>
                                                                                <ItemsControl ItemsSource="{Binding PickerNavKeys}" Margin="0,2,0,0">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate><UniformGrid Columns="13"/></ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Button Content="{Binding Display}" Style="{StaticResource PickerKey}" MinWidth="30" Padding="2,0" FontSize="11"
                                                                                                    Command="{Binding DataContext.PickVirtualKeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                    CommandParameter="{Binding Value}"/>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <TextBlock Text="{Binding [S0045], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Opacity="0.5" Margin="0,6,0,3"/>
                                                                                <ItemsControl ItemsSource="{Binding PickerNumpadKeys}" Width="192" HorizontalAlignment="Left">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Button Content="{Binding Display}" Style="{StaticResource PickerKey}" FontSize="11.5"
                                                                                                    Command="{Binding DataContext.PickVirtualKeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                    CommandParameter="{Binding Value}"/>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <Button Content="Num 0" Style="{StaticResource PickerKey}" Width="190" HorizontalAlignment="Left"
                                                                                        Command="{Binding PickVirtualKeyCommand}" CommandParameter="Numpad0"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <!-- media -->
                                                                    <StackPanel Visibility="{Binding IsMedia, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock Text="{Binding [S0047], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                        <ComboBox ItemsSource="{Binding MediaCommands}" DisplayMemberPath="Display"
                                                                                  SelectedValuePath="Value" SelectedValue="{Binding MediaValue}"/>
                                                                        <TextBlock Text="{Binding [S0048], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                                                                   Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                    </StackPanel>

                                                                    <!-- launcher: Buka Aplikasi -->
                                                                    <StackPanel Visibility="{Binding IsLauncher, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock Text="{Binding [S0049], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                        <!-- §159: Grid tombol Cari File + laci aplikasi + baris Dipilih +
                                                                             status ikon dicerminkan dari seksi utama (G-04–G-07). -->
                                                                        <Grid Margin="0,0,0,4">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <!-- Path TextBox -->
                                                                            <TextBox Grid.Column="0" Text="{Binding LauncherTarget, UpdateSourceTrigger=PropertyChanged}"
                                                                                     Tag="{Binding [S0050], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                                                                     Height="32" VerticalAlignment="Center"/>

                                                                            <!-- Tombol Cari File (Gambar 2: Folder Icon) -->
                                                                            <Button Grid.Column="1" Width="36" Height="32" Margin="6,0,0,0" Padding="0"
                                                                                    Command="{Binding BrowseLauncherCommand}" ToolTip="{Binding [S0051], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                                                                <views:IconView Icon="folder" Width="15" Height="15" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Button>

                                                                            <!-- Tombol Apps (Gambar 2: [Apps]) -->
                                                                            <ToggleButton Grid.Column="2" Style="{StaticResource ModToggle}"
                                                                                          IsChecked="{Binding IsAppDrawerOpen}"
                                                                                          Height="32" Padding="10,0" Margin="6,0,0,0"
                                                                                          ToolTip="{Binding [S0052], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <views:IconView Icon="apps" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                                                                                    <TextBlock Text="{Binding [S0053], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" FontFamily="{StaticResource CyberTechFont}"
                                                                                               VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </ToggleButton>
                                                                        </Grid>

                                                                        <!-- Laci Aplikasi (App Drawer - Gambar 3) -->
                                                                        <Border Visibility="{Binding IsAppDrawerOpen, Converter={StaticResource BoolVis}}"
                                                                                Background="#0E121B" BorderBrush="#232E42" BorderThickness="1.2" CornerRadius="8"
                                                                                Padding="8" Margin="0,4,0,8">
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="*"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                </Grid.RowDefinitions>

                                                                                <!-- Drawer Search Bar & Refresh -->
                                                                                <Grid Grid.Row="0" Margin="2,2,2,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBox Grid.Column="0" Text="{Binding AppDrawerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                                                             Tag="{Binding [S0054], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                                                                             Height="28" FontSize="11.5" Padding="6,2"
                                                                                             ToolTip="{Binding [S0055], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                                                                                    <Button Grid.Column="1" Height="28" Padding="10,0" Margin="6,0,0,0"
                                                                                            Command="{Binding RefreshAppDrawerCommand}" ToolTip="{Binding [S0056], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                            <views:IconView Icon="refresh" Width="11" Height="11" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                                                                            <TextBlock Text="{Binding [S0057], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="11" FontFamily="{StaticResource CyberTechFont}" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                </Grid>

                                                                                <!-- Loading progress line -->
                                                                                <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" Margin="2,0,2,4"
                                                                                             Visibility="{Binding IsLoadingApps, Converter={StaticResource BoolVis}}"/>

                                                                                <!-- App List (Format Gambar 3: Icon + Bold Name + Muted Path) -->
                                                                                <ListBox Grid.Row="2" ItemsSource="{Binding FilteredAppDrawerItems}" SelectedItem="{Binding SelectedAppDrawerItem}"
                                                                                         Height="196" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                                         Background="Transparent" BorderThickness="0">
                                                                                    <ListBox.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Grid Margin="2,3" Cursor="Hand">
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="32"/>
                                                                                                    <ColumnDefinition Width="*"/>
                                                                                                </Grid.ColumnDefinitions>

                                                                                                <!-- App Icon -->
                                                                                                <Border Grid.Column="0" Width="26" Height="26" Background="#161B26" BorderBrush="#252F42" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                                                    <Grid>
                                                                                                        <views:IconView Icon="apps" Width="14" Height="14" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                                        <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"
                                                                                                               Visibility="{Binding Icon, Converter={StaticResource NullVis}}"/>
                                                                                                    </Grid>
                                                                                                </Border>

                                                                                                <!-- App Name & Path -->
                                                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#F1F5F9" FontFamily="{StaticResource CyberTechFont}"/>
                                                                                                    <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#64748B" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                                                                                </StackPanel>
                                                                                            </Grid>
                                                                                        </DataTemplate>
                                                                                    </ListBox.ItemTemplate>
                                                                                    <ListBox.ItemContainerStyle>
                                                                                        <Style TargetType="ListBoxItem">
                                                                                            <Setter Property="Padding" Value="6,4"/>
                                                                                            <Setter Property="Margin" Value="0,0,0,2"/>
                                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                                            <Setter Property="Template">
                                                                                                <Setter.Value>
                                                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                                                                            <ContentPresenter/>
                                                                                                        </Border>
                                                                                                        <ControlTemplate.Triggers>
                                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                                <Setter TargetName="Bd" Property="Background" Value="#1C2536"/>
                                                                                                            </Trigger>
                                                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                                                <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                                                                                                            </Trigger>
                                                                                                        </ControlTemplate.Triggers>
                                                                                                    </ControlTemplate>
                                                                                                </Setter.Value>
                                                                                            </Setter>
                                                                                            <!-- §159: pemilihan item lewat SelectedItem (tanpa code-behind) - G-05. -->
                                                                                        </Style>
                                                                                    </ListBox.ItemContainerStyle>
                                                                                </ListBox>
                                                                                <!-- Empty-state laci (§45): keterangan saat daftar kosong. -->
                                                                                <TextBlock Grid.Row="3" Text="{Binding AppDrawerEmptyText}" TextWrapping="Wrap"
                                                                                           Margin="2,6,2,2" Foreground="#94A3B8" FontSize="11.5"
                                                                                           FontFamily="{StaticResource CyberTechFont}"
                                                                                           Visibility="{Binding HasAppDrawerEmptyText, Converter={StaticResource BoolVis}}"/>
                                                                            </Grid>
                                                                        </Border>

                                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                                                    Visibility="{Binding HasPickedApp, Converter={StaticResource BoolVis}}">
                                                                            <TextBlock Text="✓" Foreground="#4ADE80" FontSize="13" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding PickedAppName}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                        <!-- Status fetch ikon launcher: sebelumnya hanya ada di
                                                                             panel link, jadi gagal fetch launcher tidak terlihat. -->
                                                                        <TextBlock Text="{Binding IconFetchStatus}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,4,0,0"
                                                                                   Visibility="{Binding HasIconFetchStatus, Converter={StaticResource BoolVis}}"/>
                                                                    </StackPanel>

                                                                    <!-- link: Buka Link -->
                                                                    <StackPanel Visibility="{Binding IsLink, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock Text="{Binding [S0059], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                        <TextBox Text="{Binding LinkUrl}" FontSize="13"/>
                                                                        <TextBlock Text="{Binding [S0060], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                                                                   Opacity="0.55" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding IconFetchStatus}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,4,0,0"
                                                                                   Visibility="{Binding HasIconFetchStatus, Converter={StaticResource BoolVis}}"/>
                                                                    </StackPanel>

                                                                    <!-- obs -->
                                                                    <StackPanel Visibility="{Binding IsObs, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock Text="{Binding [S0061], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                        <ComboBox ItemsSource="{Binding ObsCommands}" DisplayMemberPath="Display"
                                                                                  SelectedValuePath="Value" SelectedValue="{Binding ObsCommandValue}"/>
                                                                        <!-- §158 pass kedua koordinator: gerbang +
                                                                             tombol ↻ + hint daftar live disalin dari
                                                                             seksi utama - ComboStepViewModel
                                                                             mengekspos ObsNeedsName/ObsNeedsName2/
                                                                             ObsNeedsValue, ObsNameLabel/ObsName2Label/
                                                                             ObsValueLabel/ObsValueHint, ObsListHint/
                                                                             ObsList2Hint, dan RefreshObsNamesCommand/
                                                                             RefreshObsNames2Command; owner me-refresh
                                                                             daftar per langkah. -->
                                                                        <StackPanel Visibility="{Binding ObsNeedsName, Converter={StaticResource BoolVis}}">
                                                                            <TextBlock Text="{Binding ObsNameLabel}" Style="{StaticResource FieldLabel}"/>
                                                                            <DockPanel>
                                                                                <Button Content="↻" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2"
                                                                                        Command="{Binding RefreshObsNamesCommand}" ToolTip="{Binding [S0063], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                                                                                <ComboBox IsEditable="True" ItemsSource="{Binding ObsNameOptions}"
                                                                                          Text="{Binding ObsNameText, UpdateSourceTrigger=PropertyChanged}"/>
                                                                            </DockPanel>
                                                                            <TextBlock Text="{Binding ObsListHint}" Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                        </StackPanel>
                                                                        <StackPanel Visibility="{Binding ObsNeedsName2, Converter={StaticResource BoolVis}}">
                                                                            <TextBlock Text="{Binding ObsName2Label}" Style="{StaticResource FieldLabel}"/>
                                                                            <DockPanel>
                                                                                <Button Content="↻" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2"
                                                                                        Command="{Binding RefreshObsNames2Command}" ToolTip="{Binding [S0063], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                                                                                <ComboBox IsEditable="True" ItemsSource="{Binding ObsName2Options}"
                                                                                          Text="{Binding ObsName2Text, UpdateSourceTrigger=PropertyChanged}"/>
                                                                            </DockPanel>
                                                                            <TextBlock Text="{Binding ObsList2Hint}" Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                        </StackPanel>
                                                                        <StackPanel Visibility="{Binding ObsNeedsValue, Converter={StaticResource BoolVis}}">
                                                                            <TextBlock Text="{Binding ObsValueLabel}" Style="{StaticResource FieldLabel}"/>
                                                                            <TextBox Text="{Binding ObsValueText}"/>
                                                                            <TextBlock Text="{Binding ObsValueHint}" Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding [S0064], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Opacity="0.55" FontSize="11" Margin="0,6,0,0"/>
                                                                    </StackPanel>

                                                                    <!-- streamerbot -->
                                                                    <StackPanel Visibility="{Binding IsStreamerBot, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock Text="{Binding [S1753], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                        <!-- §158 pass kedua koordinator: tombol ↻ +
                                                                             hint discovery disalin dari seksi utama -
                                                                             ComboStepViewModel mengekspos
                                                                             RefreshStreamerBotActionsCommand dan
                                                                             StreamerBotDiscoveryHint; owner
                                                                             me-refresh daftar per langkah. -->
                                                                        <DockPanel>
                                                                            <Button Content="↻" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2"
                                                                                    Command="{Binding RefreshStreamerBotActionsCommand}" ToolTip="{Binding [S0063], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                                                                            <ComboBox IsEditable="True" ItemsSource="{Binding StreamerBotActionOptions}"
                                                                                      Text="{Binding StreamerBotActionText, UpdateSourceTrigger=PropertyChanged}"/>
                                                                        </DockPanel>
                                                                        <TextBlock Text="{Binding StreamerBotDiscoveryHint}" Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                        <TextBlock Text="{Binding [S1754], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                        <TextBox Text="{Binding StreamerBotArgsText}"/>
                                                                    </StackPanel>

                                                                    <!-- steam -->
                                                                    <StackPanel Visibility="{Binding IsSteam, Converter={StaticResource BoolVis}}">
                                                                        <!-- Warning jika Steam belum terpasang -->
                                                                        <Border Visibility="{Binding IsSteamNotInstalled, Converter={StaticResource BoolVis}}"
                                                                                Background="#3B1C1C" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="6"
                                                                                Padding="10,8" Margin="0,0,0,10">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <views:IconView Icon="flag" Width="15" Height="15" Foreground="#F87171" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                                <TextBlock Text="{Binding [S1855], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                                                                           Foreground="#FCA5A5" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <TextBlock Text="{Binding [S1850], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                        <ComboBox ItemsSource="{Binding SteamCommands}" DisplayMemberPath="Display"
                                                                                  SelectedValuePath="Value" SelectedValue="{Binding SteamCommandValue}"/>

                                                                        <!-- Jalankan Game: Pemilih Game -->
                                                                        <StackPanel Visibility="{Binding IsSteamGame, Converter={StaticResource BoolVis}}" Margin="0,10,0,0">
                                                                            <Grid Margin="0,0,0,4">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0" Text="{Binding [S1851], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                                                                                <Button Grid.Column="1" Width="28" Height="24" Padding="0"
                                                                                        Command="{Binding RefreshSteamGamesCommand}" ToolTip="{Binding [S1872], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                                                                    <views:IconView Icon="refresh" Width="12" Height="12" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Button>
                                                                            </Grid>

                                                                            <ComboBox ItemsSource="{Binding SteamGameOptions}" DisplayMemberPath="Display"
                                                                                      SelectedValuePath="AppId" SelectedValue="{Binding SteamAppId}"
                                                                                      Tag="{Binding [S1851], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                                                                            <TextBlock Text="{Binding SteamGameSummaryText}" Opacity="0.55" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                                        </StackPanel>

                                                                        <!-- Mode Big Picture: Pilihan Aksi (Toggle, Masuk, Keluar) -->
                                                                        <StackPanel Visibility="{Binding IsSteamBigPicture, Converter={StaticResource BoolVis}}" Margin="0,10,0,0">
                                                                            <TextBlock Text="{Binding [S1882], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                            <ComboBox ItemsSource="{Binding SteamBigPictureOptions}" DisplayMemberPath="Display"
                                                                                      SelectedValuePath="Value" SelectedValue="{Binding SteamBigPictureMode}"/>
                                                                        </StackPanel>

                                                                        <!-- Ubah Status: Pilihan Status -->
                                                                        <StackPanel Visibility="{Binding IsSteamStatus, Converter={StaticResource BoolVis}}" Margin="0,10,0,0">
                                                                            <TextBlock Text="{Binding [S1867], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                            <ComboBox ItemsSource="{Binding SteamStatuses}" DisplayMemberPath="Display"
                                                                                      SelectedValuePath="Value" SelectedValue="{Binding SteamStatusValue}"/>
                                                                        </StackPanel>

                                                                        <!-- Checkbox Mode Toggle (Tampil untuk perintah yang relevan: launch, status, downloads, friends) -->
                                                                        <Border Visibility="{Binding SteamShowTogglePanel, Converter={StaticResource BoolVis}}"
                                                                                Background="#121722" BorderBrush="#232E42" BorderThickness="1" CornerRadius="6"
                                                                                Padding="10,8" Margin="0,12,0,0">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding [S1856], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                                                                               FontWeight="SemiBold" FontSize="12" Foreground="#F1F5F9"/>
                                                                                    <TextBlock Text="{Binding SteamToggleHintText}" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                                                </StackPanel>
                                                                                <CheckBox Grid.Column="1" IsChecked="{Binding SteamIsToggle}" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                                    <CheckBox.Template>
                                                                                        <ControlTemplate TargetType="CheckBox">
                                                                                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                                                                                    Background="#1E222D" BorderBrush="#3A4152" BorderThickness="1">
                                                                                                <Path x:Name="Check" Data="M 3,8 L 6.5,11.5 L 13,4.5" Stroke="#FFFFFF" StrokeThickness="2"
                                                                                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                            </Border>
                                                                                            <ControlTemplate.Triggers>
                                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                                    <Setter TargetName="Box" Property="Background" Value="#1E86E0"/>
                                                                                                    <Setter TargetName="Box" Property="BorderBrush" Value="#1E86E0"/>
                                                                                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                                                                                </Trigger>
                                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                                    <Setter TargetName="Box" Property="BorderBrush" Value="#1E86E0"/>
                                                                                                </Trigger>
                                                                                            </ControlTemplate.Triggers>
                                                                                        </ControlTemplate>
                                                                                    </CheckBox.Template>
                                                                                </CheckBox>
                                                                            </Grid>
                                                                        </Border>

                                                                        <!-- Pilihan saat game sedang berjalan (DI BAWAH panel toggle mode) -->
                                                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowSteamRunningGameOptions, Converter={StaticResource BoolVis}}">
                                                                            <TextBlock Text="{Binding [S1873], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                            <ComboBox ItemsSource="{Binding SteamRunningGameActions}" DisplayMemberPath="Display"
                                                                                      SelectedValuePath="Value" SelectedValue="{Binding SteamRunningGameAction}"/>
                                                                        </StackPanel>

                                                                        <!-- Status Profil Kedua (DI BAWAH panel toggle mode) -->
                                                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowSteamSecondStatusOptions, Converter={StaticResource BoolVis}}">
                                                                            <TextBlock Text="{Binding [S1861], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                            <ComboBox ItemsSource="{Binding SteamStatuses}" DisplayMemberPath="Display"
                                                                                      SelectedValuePath="Value" SelectedValue="{Binding SteamStatusSecondValue}"/>
                                                                        </StackPanel>
                                                                    </StackPanel>

                                                                    <!-- sound -->
