                                                                        <!-- §158 pass kedua koordinator: gerbang
                                                                             DeckNeedsPage disalin dari seksi utama -
                                                                             ComboStepViewModel mengeksposnya. -->
                                                                        <StackPanel Visibility="{Binding DeckNeedsPage, Converter={StaticResource BoolVis}}">
                                                                            <TextBlock Text="{Binding [S0068], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                            <ComboBox ItemsSource="{Binding DeckPageOptions}" DisplayMemberPath="Display"
                                                                                      SelectedValuePath="Value" SelectedValue="{Binding DeckPageId}"/>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding [S0069], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                                                                   Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                    </StackPanel>

                                                                    <StackPanel Visibility="{Binding IsBasic, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock Text="{Binding [S0070], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                        <ComboBox ItemsSource="{Binding BasicCommands}" DisplayMemberPath="Display"
                                                                                  SelectedValuePath="Value" SelectedValue="{Binding BasicValue}"/>
                                                                        <TextBlock Text="{Binding [S0071], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                                                                   Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                    </StackPanel>

                                                                    <StackPanel Visibility="{Binding IsWindows, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock Text="{Binding [S0072], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                        <!-- §158 pass kedua koordinator: sumber daftar
                                                                             disamakan dengan seksi utama -
                                                                             CurrentWindowsOptions (partisi menurut
                                                                             SelectedActionId, gabungan 94 untuk
                                                                             langkah lama "windows"). -->
                                                                        <views:SearchablePanelPicker ItemsSource="{Binding CurrentWindowsOptions}"
                                                                                                      SelectedKey="{Binding WindowsValue}"
                                                                                                      EscapeClearsFilterFirst="True"
                                                                                                      UseWordAndFilter="True"/>
                                                                        <TextBlock Text="{Binding [S0073], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                                                                   Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                    </StackPanel>

                                                                    <StackPanel Visibility="{Binding IsBrowser, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock Text="{Binding [S0074], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                        <!-- §159: Grid pemilih exe + tombol Pindai dicerminkan dari
                                                                             seksi utama (G-10). Pemilih exe TETAP di luar gerbang dropdown. -->
                                                                        <Grid Margin="0,0,0,4">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <ComboBox Grid.Column="0" ItemsSource="{Binding BrowserOptions}" DisplayMemberPath="Display"
                                                                                      SelectedValuePath="ExePath" SelectedValue="{Binding BrowserExe}" Tag="{Binding [S0075], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                                                                            <Button Grid.Column="1" Content="{Binding PindaiButtonText}" Command="{Binding PindaiBrowsersCommand}" Margin="6,0,0,0"/>
                                                                        </Grid>
                                                                        <!-- Pemilih exe DI LUAR gerbang, sama
                                                                             seperti seksi utama: memilih CUSTOM
                                                                             tidak boleh menyembunyikan pemilih
                                                                             itu sendiri. -->
                                                                        <StackPanel Visibility="{Binding IsBrowserDropdown, Converter={StaticResource BoolVis}}">
                                                                        <Grid Margin="0,12,0,4">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding [S0076], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding [S0077], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Foreground="#E8EAF0" VerticalAlignment="Center"/>
                                                                                <CheckBox IsChecked="{Binding BrowserProfileMulti}" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                                    <CheckBox.Template>
                                                                                        <ControlTemplate TargetType="CheckBox">
                                                                                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                                                                                    Background="#1E222D" BorderBrush="#3A4152" BorderThickness="1">
                                                                                                <Path x:Name="Check" Data="M 3,8 L 6.5,11.5 L 13,4.5" Stroke="#FFFFFF" StrokeThickness="2"
                                                                                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                            </Border>
                                                                                            <ControlTemplate.Triggers>
                                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                                    <Setter TargetName="Box" Property="Background" Value="#1E86E0"/>
                                                                                                    <Setter TargetName="Box" Property="BorderBrush" Value="#1E86E0"/>
                                                                                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                                                                                </Trigger>
                                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                                    <Setter TargetName="Box" Property="BorderBrush" Value="#1E86E0"/>
                                                                                                </Trigger>
                                                                                            </ControlTemplate.Triggers>
                                                                                        </ControlTemplate>
                                                                                    </CheckBox.Template>
                                                                                </CheckBox>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                        <views:SearchablePanelPicker ItemsSource="{Binding BrowserProfileOptions}"
                                                                                                      SelectedKey="{Binding BrowserProfileKey}"
                                                                                                      IsMultiSelect="{Binding BrowserProfileMulti}"
                                                                                                      CheckedKeys="{Binding BrowserProfileKeys}"
                                                                                                      Placeholder="{Binding BrowserProfilePlaceholder}"/>
                                                                    </StackPanel>
                                                                        <!-- §159: gerbang CUSTOM + tombol browse manual dicerminkan
                                                                             dari seksi utama (G-11); Forget + status ikon di bawah (G-12/G-13). -->
                                                                    <StackPanel Visibility="{Binding IsBrowserCustom, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock Text="{Binding [S0078], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                            <Grid Margin="0,0,0,4">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBox Grid.Column="0" Text="{Binding ManualBrowserExe, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [S0079], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                                                                                <Button Grid.Column="1" Content="{Binding [S0080], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding BrowseManualExeCommand}" Margin="6,0,0,0"/>
                                                                            </Grid>
                                                                        <TextBlock Text="{Binding [S0081], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                            <Grid Margin="0,0,0,4">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBox Grid.Column="0" Text="{Binding ManualProfilePath, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [S0082], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                                                                                <Button Grid.Column="1" Content="{Binding [S0080], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding BrowseManualFolderCommand}" Margin="6,0,0,0"/>
                                                                            </Grid>
                                                                        <TextBlock Text="{Binding ManualProfileStatus}" Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                        <TextBlock Text="{Binding [S0083], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                                                                   Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                    </StackPanel>
                                                                        <TextBlock Text="{Binding [S0084], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                        <ComboBox ItemsSource="{Binding BrowserOpenModeOptions}" DisplayMemberPath="Display"
                                                                                  SelectedValuePath="Value" SelectedValue="{Binding BrowserOpenMode}"/>
                                                                        <TextBlock Text="{Binding [S0085], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                        <TextBox Text="{Binding BrowserUrl, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [S0086], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                                                                 Height="32" VerticalAlignment="Center"/>
                                                                        <Button Content="{Binding [S0087], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding ForgetTrackedBrowserCommand}"
                                                                                   Visibility="{Binding HasTrackedBrowserWindow, Converter={StaticResource BoolVis}}"
                                                                                   ToolTip="{Binding [S0088], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                                                                   HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                                                        <TextBlock Text="{Binding [S0089], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                                                                   Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                        <TextBlock Text="{Binding IconFetchStatus}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,4,0,0"
                                                                                   Visibility="{Binding HasIconFetchStatus, Converter={StaticResource BoolVis}}"/>
                                                                    </StackPanel>

                                                                    <StackPanel Visibility="{Binding IsBrowserGroup, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock Text="{Binding [S0090], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                        <!-- §158 pass kedua koordinator: tombol
                                                                             Kelola disalin dari seksi utama -
                                                                             ComboStepViewModel mengekspos
                                                                             ManageBrowserGroupsCommand yang
                                                                             meneruskan event ke handler owner. -->
                                                                        <Grid Margin="0,0,0,4">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <ComboBox Grid.Column="0" ItemsSource="{Binding BrowserGroupOptions}" DisplayMemberPath="Display"
                                                                                      SelectedValuePath="Value" SelectedValue="{Binding BrowserGroupId}"/>
                                                                            <Button Grid.Column="1" Content="{Binding [S0091], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding ManageBrowserGroupsCommand}" Margin="6,0,0,0"/>
                                                                        </Grid>
                                                                        <TextBlock Text="{Binding [S0092], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                                                                   Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                        <TextBlock Text="{Binding IconFetchStatus}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,4,0,0"
                                                                                   Visibility="{Binding HasIconFetchStatus, Converter={StaticResource BoolVis}}"/>
                                                                    </StackPanel>

                                                                    <StackPanel Visibility="{Binding IsMacro, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock Text="{Binding [S0093], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                        <!-- §158 pass kedua koordinator: tombol
                                                                             Kelola disalin dari seksi utama -
                                                                             ComboStepViewModel mengekspos
                                                                             ManageMacrosCommand yang meneruskan
                                                                             event ke handler owner. -->
                                                                        <Grid Margin="0,0,0,4">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <ComboBox Grid.Column="0" ItemsSource="{Binding MacroOptions}" DisplayMemberPath="Display"
                                                                                      SelectedValuePath="Value" SelectedValue="{Binding MacroId}"/>
                                                                            <Button Grid.Column="1" Content="{Binding [S0094], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding ManageMacrosCommand}" Margin="6,0,0,0"/>
                                                                        </Grid>
                                                                        <TextBlock Text="{Binding [S0095], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                                                                   Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                    </StackPanel>

                                                                    <StackPanel Visibility="{Binding IsProfile, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock Text="{Binding [S0096], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                                                                        <ComboBox ItemsSource="{Binding ProfileOptions}" DisplayMemberPath="Display"
                                                                                  SelectedValuePath="Value" SelectedValue="{Binding ProfileId}"/>
                                                                        <TextBlock Text="{Binding [S0097], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                                                                   Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                    </StackPanel>

                                                                    <!-- DelayAfterMs: TIDAK diikat di sini, sesuai
                                                                         keputusan §158 A5 (koordinator): tidak ada
                                                                         kontrol delay yang reusable (pola langkah
                                                                         macro adalah code-behind); properti
                                                                         DelayAfterMs ADA di ComboStepViewModel dan
                                                                         di-round-trip (tidak pernah di-nol-kan),
                                                                         hanya saja tidak ada UI yang mengubahnya. -->
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- Tombol tambah langkah: DataContext-nya baris kombinasi
                                                     (CombinationItemViewModel), bukan langkah. Nama command
                                                     AddStepCommand adalah ASUMSI Worker B dari pasangan
                                                     AddCombinationCommand/DeleteStepCommand - tidak ada di
                                                     permukaan kontrak tertulis; koordinator WAJIB mencocokkan
                                                     dengan nama sebenarnya dari Worker A pada pass kedua
                                                     (bila berbeda, ubah binding ini saja). Teks memakai kunci
                                                     S0196 yang sudah ada ("Tambah langkah"). -->
                                                <Button Height="28" Padding="12,0" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                        Command="{Binding AddStepCommand}"
                                                        ToolTip="{Binding [S0196], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="+" FontSize="13" FontWeight="Bold" Margin="0,0,5,0" Foreground="#5BE4FF" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding [S0196], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource CyberTechFont}" Foreground="#E0E6F0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Row 2: Optional Label -->
                                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding [S0109], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" FontSize="11.5" Height="28" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding [S0110], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="{Binding [S0110], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Width="80" Margin="0,0,6,0" Padding="0,5"
                            Command="{Binding SetIconTabCommand}" CommandParameter="catalog">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1E222D"/>
                                <Setter Property="BorderBrush" Value="#3A4152"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#E8EAF0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IconTabCatalogSelected}" Value="True">
                                        <Setter Property="Background" Value="#17456E"/>
                                        <Setter Property="BorderBrush" Value="#1E86E0"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{Binding [S0111], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Width="80" Padding="0,5"
                            Command="{Binding SetIconTabCommand}" CommandParameter="upload">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1E222D"/>
                                <Setter Property="BorderBrush" Value="#3A4152"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#E8EAF0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IconTabUploadSelected}" Value="True">
                                        <Setter Property="Background" Value="#17456E"/>
                                        <Setter Property="BorderBrush" Value="#1E86E0"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <!-- Tab Content Container: Height stabilized so switching tabs never shifts elements below -->
                <Grid MinHeight="292">
                    <!-- Tab 1: Ikon Catalog -->
                    <StackPanel Visibility="{Binding IconTabCatalogSelected, Converter={StaticResource BoolVis}}">
                        <ItemsControl ItemsSource="{Binding IconOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="37" Height="37" Margin="0,0,5,5" Padding="0"
                                            Background="#1E222D"
                                            Command="{Binding DataContext.PickIconCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Value}">
                                        <views:IconView Icon="{Binding Value}" Width="21" Height="21" Foreground="#E8EAF0"/>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="BorderBrush" Value="#3A4152"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#17456E"/>
                                                        <Setter Property="BorderBrush" Value="#1E86E0"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Width="37" Height="37" Background="#1E222D" BorderBrush="#3A4152" BorderThickness="1"
                                    CornerRadius="6" Margin="0,0,10,0" ToolTip="{Binding [S0112], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                <Grid>
                                    <views:IconView Icon="{Binding IconPreviewKey}" Width="21" Height="21" Foreground="#E8EAF0"
                                                    Visibility="{Binding IconPreviewKey, Converter={StaticResource NullVis}}"/>
                                    <TextBlock Text="{Binding IconPreviewGlyph}" FontSize="17" Foreground="#E8EAF0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding IconPreviewGlyph, Converter={StaticResource NullVis}}"/>
                                    <Image Source="{Binding UploadedIconPath, Converter={StaticResource FileIconImage}}" Width="30" Height="30"
                                           Visibility="{Binding UploadedIconPath, Converter={StaticResource NullVis}}"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding [S0113], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Opacity="0.65" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Text="{Binding Icon}" Width="220" FontSize="15" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Tab 2: Upload Drop Zone (Resized to match Ikon tab height) -->
                    <StackPanel Visibility="{Binding IconTabUploadSelected, Converter={StaticResource BoolVis}}">
                        <Border AllowDrop="True" Height="236" Background="#1E222D" BorderBrush="#3A4152" BorderThickness="1"
                                CornerRadius="6" Padding="16" Drop="UploadDropZone_Drop" DragOver="UploadDropZone_DragOver">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <views:IconView Icon="image" Width="30" Height="30" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding [S0114], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" HorizontalAlignment="Center" FontSize="13" Foreground="#E2E8F0"/>
                                <TextBlock Text="{Binding [S0115], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" HorizontalAlignment="Center" Opacity="0.6" Margin="0,6"/>
                                <Button Content="{Binding [S0116], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Click="BrowseIcon_Click" HorizontalAlignment="Center" Padding="20,5"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding UploadedIconPath, Converter={StaticResource NullVis}}">
                            <Border Width="40" Height="40" Background="#1E222D" BorderBrush="#3A4152" BorderThickness="1"
                                    CornerRadius="6" Margin="0,0,10,0">
                                <Image Source="{Binding UploadedIconPath, Converter={StaticResource FileIconImage}}" Width="32" Height="32"/>
                            </Border>
                            <TextBlock Text="{Binding [S0117], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.75" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="{Binding IconUploadInfo}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding [S0118], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                   Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding [S0119], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                <ItemsControl ItemsSource="{Binding ColorOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="34" Height="34" Margin="0,0,6,6" Padding="0" Background="{Binding Value}"
                                    Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Value}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="BorderBrush" Value="#3A4152"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="#FFC65C"/>
                                                <Setter Property="BorderThickness" Value="2.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Border Width="30" Height="30" Background="{Binding ColorHex}" BorderBrush="#3A4152" BorderThickness="1" CornerRadius="4"/>
                    <TextBox Text="{Binding ColorHex}" Width="92" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Button Command="{Binding PickCustomColorCommand}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal"><views:IconView Icon="droplet" Width="13" Height="13" VerticalAlignment="Center"/><TextBlock Text="{Binding [S0120], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding ExtraStepsNote}" TextWrapping="Wrap" Opacity="0.6" FontSize="11" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="#FF7A72" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Foreground="#7BE495" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="22,14,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Pesan Save/Test di footer (di luar ScrollViewer): pasangan
                 di dasar scroll (:1198-1199) tenggelam di bawah lipatan
                 saat konten lebih tinggi dari viewport, sehingga klik
                 Simpan yang ditolak tampak diam. Baris ini Collapse
                 saat kosong, jadi tidak menggeser tombol. -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="#FF7A72" Margin="0,0,0,2"
                           Visibility="{Binding HasErrorText, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Foreground="#7BE495"
                           Visibility="{Binding HasResultText, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <Button Content="{Binding [S0121], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" HorizontalAlignment="Left" Height="34" Padding="14,0"
                        Style="{StaticResource DangerButton}"
                        FontFamily="{StaticResource CyberTechFont}" FontWeight="Bold" FontSize="12"
                        Command="{Binding DeleteCommand}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding [S0122], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource GhostButton}" Width="86" Height="34" Margin="0,0,8,0"
                            Command="{Binding TestCommand}" FontFamily="{StaticResource CyberTechFont}" FontWeight="Bold" FontSize="12.5"/>
                    <Button Content="{Binding [S0010], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource GhostButton}" Width="86" Height="34" Margin="0,0,8,0"
                            Command="{Binding CancelCommand}" FontFamily="{StaticResource CyberTechFont}" FontWeight="Bold" FontSize="12.5"/>
                    <Button Content="{Binding [S0123], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource PrimaryButton}" Width="86" Height="34"
                            Command="{Binding SaveCommand}" FontFamily="{StaticResource CyberTechFont}" FontWeight="Bold" FontSize="12.5"/>
                </StackPanel>
            </Grid>
        </Grid>
            </Grid>
        </views:ChamferBorder>
    </Grid>
</Window>
