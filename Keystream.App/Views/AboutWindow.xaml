<Window x:Class="Keystream.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Keystream.App.Views"
        xmlns:loc="clr-namespace:Keystream.App.Localization"
        Title="{Binding [S1554], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="14">
        <!-- Shadow Proxy Layer -->
        <Border CornerRadius="16" Background="#0A0C14" Margin="2">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.85" BlurRadius="18" ShadowDepth="4" Direction="315"/>
            </Border.Effect>
        </Border>

        <!-- Main Window Frame (chassis modal standar, sama seperti MACRO) -->
        <views:ChamferBorder Chamfer="20" ClipChild="True"
                             Background="{StaticResource WindowBackgroundBrush}"
                             BorderBrush="{StaticResource ChassisMilledBevelBrush}"
                             InnerBevelBrush="{StaticResource ChassisInnerBevelBrush}"
                             BorderThickness="2.8"
                             SpecularTopHighlight="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header merek (§100): judul gradasi + tagline
                     persis seperti header dashboard, TANPA tombol X.
                     Background Transparent (bukan null) supaya seluruh
                     lebar header tetap bisa digeser.
                     §173: jarak judul→logo dirapatkan (bawah 14→6)
                     agar blok ikon–Tutup geser ke atas; ukuran modal
                     (Width 480, SizeToContent Height) tidak berubah. -->
                <Border Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel HorizontalAlignment="Center" Margin="0,20,0,6">
                        <TextBlock Text="{Binding [S0211], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="19" FontWeight="Bold"
                                   Foreground="{StaticResource KeystreamTitleGradientBrush}"
                                   FontFamily="{StaticResource CyberTitleFont}"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="Visual Macro Deck Controller" FontSize="10" Foreground="#8A93A5" FontWeight="SemiBold"
                                   FontFamily="{StaticResource CyberTechFont}" Margin="0,2,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Body Content (§100: SEMUA rata tengah; §101: baris
                     nama non-bold dibuang, versi menempel pada nama
                     bold di bawah logo; §173: atas 12→4, lanjutan
                     rapat judul→logo) -->
                <Grid Grid.Row="1" Margin="22,4,22,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo (§100): tengah, di atas versi + hak cipta -->
                    <Image Grid.Row="0" Height="60" HorizontalAlignment="Center"
                           Source="pack://application:,,,/Keystream;component/Assets/keystream.png"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- §101: nama + versi MENYATU di baris bold ini -
                         VersionText sudah berisi "KEYSTREAM v1.0.0"
                         (format S0345 dari MainViewModel). Baris nama
                         S0211 non-bold yang lama dibuang. -->
                    <TextBlock Grid.Row="1" x:Name="VersionText" FontSize="16" FontWeight="Bold"
                               Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}" Margin="0,8,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="© 2026 FLD" FontSize="11.5"
                               Foreground="#8A93A5" FontFamily="{StaticResource CyberTechFont}" Margin="0,2,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center"/>

                    <!-- Deskripsi (§100: baris "proyek open source" S1556
                         DIBUANG atas perintah user - kuncinya tetap di
                         tabel, hanya tak terpakai di XAML) -->
                    <TextBlock Grid.Row="3" Text="{Binding [S1555], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="#CBD5E1" Margin="0,10,0,0"/>

                    <!-- §98 tautan (§99: tinggal GitHub + Donasi,
                         Telegram/YouTube dibuang atas perintah user):
                         URL sudah diisi di kamus Urls di
                         AboutWindow.xaml.cs; kedua tombol di bawah
                         aktif. -->
                    <!-- §171: ikon sebelum teks - GitHub memakai
                         kunci katalog "code" (tidak ada glyph GitHub
                         di katalog; substitusi terdokumentasi), Donasi
                         memakai "heart" merah. URL + logika aktif
                         tidak berubah (Link_Click / kamus Urls). -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Style="{StaticResource GhostButton}" Padding="14,6" Margin="0,0,8,0"
                                Click="Link_Click" Tag="github">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <views:IconView Icon="code" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="GitHub" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="14,6"
                                Click="Link_Click" Tag="donate">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <views:IconView Icon="heart" Width="14" Height="14" Foreground="#EF4444" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [S1557], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- §171: kalimat bintang + kopi (S1821, ID+EN),
                         di bawah tombol sebagai keterangan. -->
                    <TextBlock Grid.Row="5" Text="{Binding [S1821], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="#8A93A5" FontSize="11.5"
                               FontFamily="{StaticResource CyberTechFont}" Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>

                    <!-- Kredit komponen (teks saja, tanpa tautan) -->
                    <StackPanel Grid.Row="6" Margin="0,12,0,0">
                        <TextBlock Text="{Binding [S1560], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                   FontWeight="Bold" FontSize="12" Foreground="#E8EAF0" Margin="0,0,0,6"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="{Binding [S1559], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                   FontSize="11.5" Foreground="#8A93A5" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Footer (§100): tombol Close di TENGAH.
                         §171: tombol Periksa Pembaruan PINDAH ke
                         Pengaturan (bagian paling bawah) - tidak ada
                         lagi tombol pembaruan di modal ini. -->
                    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Content="{Binding [S0003], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                Style="{StaticResource PrimaryButton}" Width="100" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </views:ChamferBorder>
    </Grid>
</Window>
