<Window x:Class="Keystream.App.Views.DeckStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Keystream.App.Views"
        xmlns:loc="clr-namespace:Keystream.App.Localization"
        Title="{Binding [S0256], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- Hanya converter, seperti ObsConfigWindow: TIDAK ada style
             Button window-local (§78) - tombol memakai gaya global
             default, preseden DeckDevicePickerWindow. -->
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <Grid Margin="14">
        <!-- Shadow proxy layer: isolated shadow layer, prevents text blur and border artifacts -->
        <Border CornerRadius="16" Background="#0A0C14" Margin="2">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.8" BlurRadius="16" ShadowDepth="4" Direction="315"/>
            </Border.Effect>
        </Border>

        <!-- §149 C2: chassis modal standar (preseden DeckDevicePickerWindow
             §61 / ObsConfigWindow): ChamferBorder 20 ClipChild + header
             44px drag + × + footer. Isi = salinan baris seksi Keyboard
             Deck SettingsWindow (nama + "!" + 2 baris status + pesan +
             2 tombol), mengikat ViewModel Settings yang SAMA - tanpa
             ViewModel kedua, tanpa staging/save. -->
        <views:ChamferBorder Chamfer="20" ClipChild="True"
                             Background="{StaticResource WindowBackgroundBrush}"
                             BorderBrush="{StaticResource ChassisMilledBevelBrush}"
                             InnerBevelBrush="{StaticResource ChassisInnerBevelBrush}"
                             BorderThickness="2.8"
                             SpecularTopHighlight="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Border Grid.Row="0" BorderBrush="#1E86E0" BorderThickness="0,0,0,1.5"
                        Background="{StaticResource HeaderBackgroundBrush}"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Height="44" Margin="18,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <views:IconView Icon="keyboard" Width="16" Height="16" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="13.5" FontWeight="Bold" Foreground="#E0F2FE"
                                       FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource ShellChromeButton}" HorizontalAlignment="Right"
                                Click="Close_Click" ToolTip="{Binding [S0003], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                            <TextBlock Text="&#x2715;" FontSize="11" FontFamily="{StaticResource CyberTechFont}" FontWeight="SemiBold" Foreground="#B9C1D1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body Content: baris-baris seksi Keyboard Deck Settings,
                     binding dan sumber yang sama persis. Nama deck di sini
                     teks biasa (bukan klik pembuka picker seperti di
                     Settings) - akses picker/wizard lewat tombol
                     S0262 di bawah. -->
                <StackPanel Grid.Row="1" Margin="22,16,22,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DeckText}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13.5" FontFamily="{StaticResource CyberTechFont}"/>
                        <Button Content="!" Width="22" Height="22" Margin="8,0,0,0" Padding="0"
                                FontWeight="Bold" ToolTip="{Binding [S0259], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                Command="{Binding ToggleDeckDetailCommand}"/>
                    </StackPanel>
                    <Border Background="#141721" BorderBrush="#262D3D" BorderThickness="1" CornerRadius="6"
                            Padding="10" Margin="0,8,0,0"
                            Visibility="{Binding ShowDeckDetail, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding DeckDetailText}" TextWrapping="Wrap" FontSize="12" FontFamily="{StaticResource CyberTechFont}" Opacity="0.85"/>
                    </Border>
                    <!-- Indikator sejajar: label kolom tetap 140 agar
                         nilai kedua baris mulai di x yang sama. -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [S0260], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Opacity="0.75" FontSize="12" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ServiceStatusText}" TextWrapping="Wrap"
                                   Foreground="{Binding ServiceStatusBrush}" FontWeight="Bold" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding [S0261], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Opacity="0.75" FontSize="12" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding DriverStatusText}" TextWrapping="Wrap" FontSize="12" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Pesan operasi ToggleService (gagal) - salinan
                         TextBlock DeckMessageText Settings (§128);
                         tanpanya kegagalan service di modal ini diam. -->
                    <TextBlock Text="{Binding DeckMessageText}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="#FCA5A5" FontSize="12" FontFamily="{StaticResource CyberTechFont}"
                               Visibility="{Binding HasDeckMessage, Converter={StaticResource BoolVis}}"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="{Binding [S0262], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding IdentifyDeckCommand}" Margin="0,0,8,0"/>
                        <!-- §173: tombol service mengikuti status hidup -
                             SATU kontrol terlihat: jalan = "Stop" merah
                             (DangerButton), berhenti = "Mulai" hijau
                             (SuccessButton); nonaktif saat Starting.
                             Label via S0674 ("Stop") + S1834 ("Mulai"). -->
                        <Button Content="{Binding [S1834], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding ToggleServiceCommand}"
                                IsEnabled="{Binding IsServiceButtonEnabled}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServiceRunning}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{Binding [S0674], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding ToggleServiceCommand}"
                                IsEnabled="{Binding IsServiceButtonEnabled}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServiceRunning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <!-- Footer: hanya Tutup (S0003) - modal ini tidak
                     men-stage/menyimpan apa pun, jadi tidak ada
                     Batal/Simpan. Pola footer ObsConfigWindow. -->
                <Border Grid.Row="2" Background="#0E121A" BorderBrush="#1C2433" BorderThickness="0,1,0,0" Padding="18,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding [S0003], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Click="Close_Click" Width="86"/>
                    </StackPanel>
                </Border>
            </Grid>
        </views:ChamferBorder>
    </Grid>
</Window>
