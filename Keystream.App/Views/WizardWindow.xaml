<Window WindowStyle="None" x:Class="Keystream.App.Views.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Keystream.App.Views"
        xmlns:loc="clr-namespace:Keystream.App.Localization"
        Title="{Binding [S0302], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Height="360" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Foreground="#E8EAF0"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="14">
        <!-- Shadow proxy layer: isolated shadow layer, prevents text blur and border artifacts -->
        <Border CornerRadius="16" Background="#0A0C14" Margin="2">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.8" BlurRadius="16" ShadowDepth="4" Direction="315"/>
            </Border.Effect>
        </Border>

        <views:ChamferBorder Chamfer="20" ClipChild="True"
                             Background="{StaticResource WindowBackgroundBrush}"
                             BorderBrush="{StaticResource ChassisMilledBevelBrush}"
                             InnerBevelBrush="{StaticResource ChassisInnerBevelBrush}"
                             BorderThickness="3.0"
                             SpecularTopHighlight="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="#1E86E0" BorderThickness="0,0,0,1.5"
                        Background="{StaticResource HeaderBackgroundBrush}"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Height="46" Margin="18,0,12,0">
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="15" FontWeight="Bold" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ShellChromeButton}" HorizontalAlignment="Right"
                                Click="Close_Click" ToolTip="{Binding [S0003], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                            <TextBlock Text="&#x2715;" FontSize="11" FontFamily="{StaticResource CyberTechFont}" FontWeight="SemiBold" Foreground="#B9C1D1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="24,18,24,14">
                    <TextBlock x:Name="StepText" TextWrapping="Wrap" FontSize="14.5" FontWeight="Bold" FontFamily="{StaticResource CyberTechFont}" Foreground="#38BDF8"
                               Text="{Binding [S0303], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="13.5" FontFamily="{StaticResource CyberTechFont}" Opacity="0.85"/>
                    <Border x:Name="HintBorder" Background="#161922" BorderBrush="#262D3D" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,16,0,0">
                        <TextBlock x:Name="HintText" TextWrapping="Wrap" Opacity="0.65" FontSize="12" FontFamily="{StaticResource CyberTechFont}" LineHeight="17"
                                   Text="{Binding [S0304], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,24,20">
                    <Button x:Name="ActionButton" Visibility="Collapsed" Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,10,0" Click="ActionButton_Click" FontFamily="{StaticResource CyberTechFont}" FontWeight="Bold"/>
                    <Button x:Name="CancelButton" IsCancel="True" Content="{Binding [S0010], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource GhostButton}" Padding="18,6" Click="Cancel_Click" FontFamily="{StaticResource CyberTechFont}" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </views:ChamferBorder>
    </Grid>
</Window>
