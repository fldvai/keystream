<Window x:Class="Keystream.App.Views.MacroManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Keystream.App.Views"
        xmlns:loc="clr-namespace:Keystream.App.Localization"
        Title="{Binding [S0180], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Height="600" Width="820"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- FieldLabel TIDAK ada di App.xaml (itu akar bug §44 di Settings):
             tiap window yang memakainya harus mendefinisikannya sendiri. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Tombol HIJAU untuk status merekam (pasangan DangerButton
             merah): salinan template DangerButton dengan gradasi hijau.
             Dipakai tombol Rekam saat merekam; saat diam tombol Rekam
             memakai DangerButton (merah). Hanya dipakai di jendela ini. -->
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Base" CornerRadius="6"
                                Background="#0E2A14"
                                BorderBrush="#1A5C2E"
                                BorderThickness="1,1,1,2">
                            <Border x:Name="Face" CornerRadius="5"
                                    Margin="1,1,1,1"
                                    BorderBrush="#4ADE80"
                                    BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2FA84F" Offset="0.0"/>
                                        <GradientStop Color="#1E7A34" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#3DBB5F" Offset="0.0"/>
                                            <GradientStop Color="#2A8F42" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#6EE7A0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1E6B2E" Offset="0.0"/>
                                            <GradientStop Color="#145A24" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Varian TextBox TANPA tombol × (ClearBtn): template global
             menampilkan × selama ada teks - untuk input Jeda di tabel
             langkah, × itu tidak diminta. Berbasis style global (warna
             gelap, fokus biru #1E86E0) tapi templatenya hanya Border +
             PART_ContentHost; Padding kanan 26 → 7 karena tidak ada
             lagi ruang yang dicadangkan untuk ×. -->
        <Style x:Key="NoClearTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="7,0,7,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- §163: CornerRadius 6 = template TextBox global -
                             tanpa ini kotak Jeda (NoClear) tetap bersudut 4. -->
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1E86E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <!-- Shadow Proxy Layer -->
        <Border CornerRadius="16" Background="#0A0C14" Margin="2">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.85" BlurRadius="18" ShadowDepth="4" Direction="315"/>
            </Border.Effect>
        </Border>

        <!-- Main Window Frame (chassis modal standar, sama seperti OBS Config) -->
        <views:ChamferBorder Chamfer="20" ClipChild="True"
                             Background="{StaticResource WindowBackgroundBrush}"
                             BorderBrush="{StaticResource ChassisMilledBevelBrush}"
                             InnerBevelBrush="{StaticResource ChassisInnerBevelBrush}"
                             BorderThickness="2.8"
                             SpecularTopHighlight="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Border Grid.Row="0" BorderBrush="#1E86E0" BorderThickness="0,0,0,1.5"
                        Background="{StaticResource HeaderBackgroundBrush}"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Height="44" Margin="18,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <views:IconView Icon="zap" Width="16" Height="16" Foreground="#4ADE80" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding [S0180], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="13.5" FontWeight="Bold"
                                       Foreground="#E0F2FE" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource ShellChromeButton}" HorizontalAlignment="Right"
                                Click="Close_Click" ToolTip="{Binding [S0003], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                            <TextBlock Text="&#x2715;" FontSize="11" FontFamily="{StaticResource CyberTechFont}" FontWeight="SemiBold" Foreground="#B9C1D1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body Content -->
                <Grid Grid.Row="1" Margin="22,16,22,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <!-- 252: tiga tombol daftar HARUS sama besar
                                 (UniformGrid) - "Duplikat" adalah yang terlebar
                                 (~74px dengan Padding bawaan 12,7), jadi
                                 padding tombol ini dikecilkan ke 6,7 agar
                                 ketiganya muat sama besar tanpa terpotong. -->
                            <ColumnDefinition Width="252"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Daftar macro -->
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="{Binding [S0181], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontWeight="Bold" Margin="0,0,0,6"/>
                            <ListBox x:Name="MacroList" Height="320" DisplayMemberPath="Display"
                                     SelectionChanged="MacroList_SelectionChanged"/>
                            <!-- §82: SATU baris, 5 sel SAMA LEBAR (simetris)
                                 - dulu 2 baris (3 + 2) berteks, kini 5 tombol
                                 ikon saja (teks fungsi pindah ke ToolTip).
                                 Hitungan: kolom daftar 252px − margin kanan
                                 StackPanel 14px = 238px usable → 5 sel
                                 ≈ 48px; tiap tombol minus Margin 3,0
                                 ≈ 42px, ikon 18px di tengah. Ikon
                                 mengikuti Foreground tombol (IconView
                                 mewarisi Foreground Button: abu terang,
                                 sama untuk kelimanya sejak §84). Semantik
                                 tombol tak berubah (§81: Ekspor =
                                 pustaka tersimpan, Impor = langsung
                                 tersimpan). ToolTip tidak tampil pada
                                 tombol nonaktif - perilaku WPF standar,
                                 sama seperti tombol langkah. -->
                            <UniformGrid Columns="5" Margin="0,8,0,0">
                                <Button x:Name="NewButton" Click="NewButton_Click" Margin="3,0" Padding="6,7" ToolTip="{Binding [S0182], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                    <views:IconView Icon="plus" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="DuplicateButton" Click="DuplicateButton_Click" Margin="3,0" Padding="6,7" ToolTip="{Binding [S0183], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                    <views:IconView Icon="copy" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <!-- §84: Style DangerButton (merah) DICABUT
                                     atas perintah user - Hapus kini sama
                                     dengan 4 tombol lain (style implisit
                                     default). -->
                                <Button x:Name="DeleteButton" Click="DeleteButton_Click" Margin="3,0" Padding="6,7" ToolTip="{Binding [S0184], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                    <views:IconView Icon="trash" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="ExportButton" Click="ExportButton_Click" Margin="3,0" Padding="6,7" ToolTip="{Binding [S0185], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                    <views:IconView Icon="upload" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="ImportButton" Click="ImportButton_Click" Margin="3,0" Padding="6,7" ToolTip="{Binding [S0186], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                    <views:IconView Icon="download" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </UniformGrid>
                            <TextBlock x:Name="EmptyText" Text="{Binding [S0187], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                       TextWrapping="Wrap" Opacity="0.75" Margin="0,10,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Editor macro -->
                        <Grid Grid.Column="1" x:Name="EditorPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <!-- §113: baris jeda 3 detik + info. -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Nama macro + Pengulangan SEBARIS: nama fleksibel
                                 di kiri, pengulangan sempit di kanan (hanya
                                 angka, maks 3 digit - 70px cukup untuk angka
                                 + panah dropdown). Label "Langkah (urutan
                                 tombol)" dihapus atas perintah user - header
                                 kolom tabel (#/Tombol/Aksi/Jeda) sudah cukup. -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <!-- Label tebal + ukuran + margin bawah SAMA
                                         dengan "Daftar Macro" (tebal, 12.5,
                                         bawah 6, atas 0): ketiga label atas
                                         sejajar penuh - atas label sama, atas
                                         kotak input sama. -->
                                    <TextBlock Text="{Binding [S0188], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"
                                               FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6"/>
                                    <TextBox x:Name="NameBox" Height="34" VerticalContentAlignment="Center"
                                             TextChanged="NameBox_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [S0189], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"
                                               FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CyclesBox" Width="64" Height="34" VerticalContentAlignment="Center"
                                              HorizontalAlignment="Left" SelectionChanged="CyclesBox_SelectionChanged"/>
                                </StackPanel>
                                <!-- §69: pengali kecepatan playback (lebar
                                     sama dengan Pengulangan - "0.75×"
                                     muat di 64px). Nilai di luar daftar
                                     (config edit-tangan) ditambahkan ke
                                     daftar saat dimuat, agar tidak hilang
                                     diam-diam saat Simpan berikutnya. -->
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding [S0190], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"
                                               FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="SpeedBox" Width="64" Height="34" VerticalContentAlignment="Center"
                                              HorizontalAlignment="Left" SelectionChanged="SpeedBox_SelectionChanged"
                                              ToolTip="{Binding [S0191], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                                </StackPanel>
                            </Grid>
                            <!-- §72: header + tabel + tombol dalam satu
                                 Grid tengah: kolom * = lebar list (header
                                 otomatis selebar tabel, bukan selebar
                                 editor penuh), kolom Auto = kolom tombol.
                                 Baris 0 = header, baris 1 = tabel +
                                 kolom tombol (tinggi sama = 281). -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                            <!-- §73: Margin kiri/kanan 12 = inset isi baris
                                 (1 border + 1 padding Border template +
                                 4 padding ScrollViewer + 6 padding item)
                                 sehingga SEMUA kolom header sejajar
                                 persis dengan kolom isi (sebelumnya isi
                                 bergeser 12px ke kanan). Margin bawah 0
                                 (dulu 4) agar celah header→baris pertama
                                 (≈9px) simetris dengan celah antar baris
                                 (≈8px). -->
                            <Grid Grid.Row="0" Grid.Column="0" Margin="12,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="#" Opacity="0.55"/>
                                <TextBlock Grid.Column="1" Text="{Binding [S0193], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Opacity="0.55"/>
                                <TextBlock Grid.Column="2" Text="{Binding [S0194], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Opacity="0.55"/>
                                <TextBlock Grid.Column="3" Text="{Binding [S0195], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Opacity="0.55"/>
                            </Grid>
                            <!-- 281: tabel langkah ditinggikan supaya total
                                 editor tetap ~379px (atas 55 + header 15 +
                                 tabel 281 + checkbox 28) = kolom daftar,
                                 jadi bawah editor tetap sejajar dengan
                                 bawah daftar. Kolom tombol di kanan
                                 mengikuti tinggi tabel ini (281/9). -->
                            <ListBox Grid.Row="1" Grid.Column="0" x:Name="StepList" Height="281"
                                     SelectionChanged="StepList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Number}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Chord}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Action}" VerticalAlignment="Center" Opacity="0.75"/>
                                            <!-- §73: input Jeda mengisi penuh
                                                 kolom 110 (dulu lebar 90 rata
                                                 kiri - ujung kanannya
                                                 menggantung 20px sebelum
                                                 ujung kolom). -->
                                            <TextBox Grid.Column="3" Text="{Binding DelayText, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                     Style="{StaticResource NoClearTextBox}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- SATU BARIS 9 tombol ikon (perintah user):
                                 4 aksi langkah + Rekam di TENGAH (posisi
                                 5 dari 9) + 4 urutan. Ikon dari SVG user
                                 (5_tombol_ICON.zip + 4 panah) → Path fill;
                                 data SVG 960-space, Stretch menormalkan
                                 bbox sehingga ikon tegak tanpa transform.
                                 Fill mengikuti Foreground tombol: normal
                                 #E8EAF0, hover putih, Rekam diam merah
                                 (DangerButton) / merekam hijau
                                 (SuccessButton), capture amber
                                 (Foreground lokal). Tombol 34×30 rata
                                 tengah sel UniformGrid (tetap simetris);
                                 tooltip menggantikan label teks. Selama
                                 rekam-chord tombol Tambah nonaktif -
                                 tooltip tetap tampil karena
                                 ShowOnDisabled. Checkbox Record Delay
                                 (§68) ada di baris bawah bersama
                                 Rekam Up/Down, bukan di baris ini. -->
                            <!-- §72: 9 tombol pindah ke kanan tabel,
                                 tersusun TEGAK (satu kolom, bukan satu
                                 baris): UniformGrid 9 baris × 1 kolom,
                                 tinggi = tinggi tabel (281) sehingga
                                 tiap tombol ~31px dan kolom persis
                                 setinggi list (simetris). Tombol tanpa
                                 Height eksplisit agar mengisi selnya
                                 (Stretch); lebar tetap 34, Margin 2,1
                                 memberi celah 1px antar tombol. Rekam
                                 tetap di tengah (posisi 5 dari 9).
                                 Checkbox (Record Delay + Rekam Up/Down)
                                 TIDAK ikut pindah - tetap di baris
                                 bawah. -->
                                <UniformGrid Grid.Row="1" Grid.Column="1" Rows="9" Margin="8,0,0,0">
                                    <Button x:Name="AddStepButton" Click="AddStepButton_Click" Margin="2,1" Padding="2"
                                            Width="34" HorizontalAlignment="Center"
                                            ToolTip="{Binding [S0196], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" ToolTipService.ShowOnDisabled="True">
                                        <Path Data="M466-466H252v-28h214v-214h28v214h214v28H494v214h-28v-214Z"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Stretch="Uniform" Width="15" Height="15"/>
                                    </Button>
                                    <Button x:Name="ChangeChordButton" Click="ChangeChordButton_Click" Margin="2,1" Padding="2"
                                            Width="34" HorizontalAlignment="Center" ToolTip="{Binding [S0197], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                        <Path Data="M172-172v-80l527-528q4.39-3.83 9.7-5.91Q714-788 719.68-788q5.67 0 11 1.5Q736-785 741-780l39 39q5 5 6.5 10.41t1.5 10.82q0 5.77-1.91 11.07-1.92 5.31-6.09 9.7L252-172h-80Zm527-487 61-60-41-41-60 61 40 40Z"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Stretch="Uniform" Width="15" Height="15"/>
                                    </Button>
                                    <Button x:Name="DeleteStepButton" Click="DeleteStepButton_Click" Margin="2,1" Padding="2"
                                            Width="34" HorizontalAlignment="Center" ToolTip="{Binding [S0198], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                        <Path Data="M312-172q-26 0-43-17t-17-43v-488h-40v-28h148v-28h240v28h148v28h-40v488q0 26-17 43t-43 17H312Zm90-108h28v-360h-28v360Zm128 0h28v-360h-28v360Z"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Stretch="Uniform" Width="12" Height="12"/>
                                    </Button>
                                    <Button x:Name="ClearStepsButton" Click="ClearStepsButton_Click" Margin="2,1" Padding="2"
                                            Width="34" HorizontalAlignment="Center" ToolTip="{Binding [S0199], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                        <Path Data="M594-266v-28h108v28H594Zm0-320v-28h228v28H594Zm0 160v-28h188v28H594ZM178-640h-40v-28h146v-28h84v28h146v28h-40v328q0 26-17 43t-43 17H238q-26 0-43-17t-17-43v-328Z"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Stretch="Uniform" Width="18" Height="18"/>
                                    </Button>
                                    <Button x:Name="RecordButton" Click="RecordButton_Click" Margin="2,1" Padding="2"
                                            Width="34" HorizontalAlignment="Center"
                                            Style="{StaticResource DangerButton}"
                                            ToolTip="{Binding [S0200], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                        <Path Data="M585-375q43-43 43-105t-43-105q-43-43-105-43t-105 43q-43 43-43 105t43 105q43 43 105 43t105-43ZM480.17-132q-72.17 0-135.73-27.39-63.56-27.39-110.57-74.35-47.02-46.96-74.44-110.43Q132-407.65 132-479.83q0-72.17 27.39-135.73 27.39-63.56 74.35-110.57 46.96-47.02 110.43-74.44Q407.65-828 479.83-828q72.17 0 135.73 27.39 63.56 27.39 110.57 74.35 47.02 46.96 74.44 110.43Q828-552.35 828-480.17q0 72.17-27.39 135.73-27.39 63.56-74.35 110.57-46.96 47.02-110.43 74.44Q552.35-132 480.17-132Zm-.17-28q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Z"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Stretch="Uniform" Width="15" Height="15"/>
                                    </Button>
                                    <Button x:Name="TopButton" Click="TopButton_Click" Margin="2,1" Padding="2"
                                            Width="34" HorizontalAlignment="Center" ToolTip="{Binding [S0201], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                        <Path Data="m296-260-20-20 204-204 204 204-20 20-184-184-184 184Zm0-240-20-20 204-204 204 204-20 20-184-184-184 184Z"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Stretch="Uniform" Width="15" Height="15"/>
                                    </Button>
                                    <Button x:Name="UpButton" Click="UpButton_Click" Margin="2,1" Padding="2"
                                            Width="34" HorizontalAlignment="Center" ToolTip="{Binding [S0138], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                        <Path Data="M466-212v-482L232-460l-20-20 268-268 268 268-20 20-234-234v482h-28Z"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Stretch="Uniform" Width="15" Height="15"/>
                                    </Button>
                                    <Button x:Name="DownButton" Click="DownButton_Click" Margin="2,1" Padding="2"
                                            Width="34" HorizontalAlignment="Center" ToolTip="{Binding [S0139], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                        <Path Data="M466-748v482L232-500l-20 20 268 268 268-268-20-20-234 234v-482h-28Z"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Stretch="Uniform" Width="15" Height="15"/>
                                    </Button>
                                    <Button x:Name="BottomButton" Click="BottomButton_Click" Margin="2,1" Padding="2"
                                            Width="34" HorizontalAlignment="Center" ToolTip="{Binding [S0202], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                        <Path Data="M480-238 276-442l20-20 184 184 184-184 20 20-204 204Zm0-238L276-680l20-20 184 184 184-184 20 20-204 204Z"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Stretch="Uniform" Width="15" Height="15"/>
                                    </Button>
                                </UniformGrid>
                                <!-- §113: overlay hitung mundur modal - sel
                                     yang sama dengan tabel langkah (baris 1,
                                     kolom 0), di atas ListBox dalam Z-order,
                                     IsHitTestVisible False sehingga tidak
                                     menggeser/memblokir apa pun. Angka saja;
                                     backdrop semi-transparan #0A0C14. -->
                                <Border x:Name="CountdownOverlay" Grid.Row="1" Grid.Column="0" CornerRadius="6"
                                        Background="#990A0C14" Visibility="Collapsed" IsHitTestVisible="False">
                                    <TextBlock x:Name="CountdownOverlayText" Text="3" FontSize="56" FontWeight="Bold"
                                               Foreground="#FFFFFF" FontFamily="{StaticResource CyberTechFont}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Pola checkbox aplikasi (Settings): Foreground
                                     #E8EAF0 + CyberTechFont eksplisit - tanpa itu
                                     teks CheckBox tampil hitam (default template
                                     tidak mewarisi Foreground jendela). Kotak
                                     centangnya tetap default, sama seperti di
                                     Settings. -->
                            </Grid>
                            <!-- Opsi mode rekam (§66; sejak §108
                                 defaultnya TIDAK centang):
                                 centang = Rekam + Tambah mencatat tekan ↓
                                 dan lepas ↑ tiap tombol; tidak centang =
                                 keduanya mencatat satu ketukan per tombol
                                 (perilaku §62). Tetap hidup selama
                                 merekam (seperti Record Delay): mengubah
                                 di tengah sesi hanya memengaruhi event
                                 berikutnya. Pola checkbox Settings
                                 (Foreground + CyberTechFont eksplisit). -->
                            <!-- §68: kedua opsi rekam satu baris di bawah
                                 list + kolom tombol (§72: baris 2 editor,
                                 dulu baris 4). -->
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="UpDownBox" Grid.Column="0" Content="{Binding [S0203], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center"
                                          IsChecked="False" Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}"
                                          Checked="UpDownBox_CheckChanged" Unchecked="UpDownBox_CheckChanged"
                                          ToolTip="{Binding [S0204], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                                <CheckBox x:Name="RecordDelayBox" Grid.Column="1" Content="{Binding [S0205], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center"
                                          IsChecked="True" Margin="16,0,0,0" Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}"
                                          Checked="RecordDelayBox_CheckChanged" Unchecked="RecordDelayBox_CheckChanged"
                                          ToolTip="{Binding [S0206], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"/>
                                <!-- §107: Rekam Mouse + gir pengaturan (sesi
                                     saja, bukan isi macro): pola checkbox
                                     Settings (Foreground + CyberTechFont
                                     eksplisit). Gir mati selama MouseBox
                                     tidak centang (RefreshMouseControls)
                                     dan selama merekam (SetEditorEnabled). -->
                                <CheckBox x:Name="MouseBox" Grid.Column="2" Content="{Binding [S1601], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center"
                                          IsChecked="False" Margin="16,0,0,0" Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}"
                                          Checked="MouseBox_CheckChanged" Unchecked="MouseBox_CheckChanged"/>
                                <Button x:Name="MouseSettingsButton" Grid.Column="3" Click="MouseSettingsButton_Click" Width="28" Height="28" Padding="0"
                                        Margin="6,0,0,0" VerticalAlignment="Center" IsEnabled="False"
                                        ToolTip="{Binding [S1602], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                    <views:IconView Icon="gear" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <!-- §113: tombol panel mengambang PINDAH ke
                                     kolom 4 (di sebelah gir), ukuran +
                                     tooltip sama; kolom 6 (*) kini kosong
                                     di ujung kanan. -->
                                <Button x:Name="FloatPanelToggleButton" Grid.Column="4" Click="FloatPanelToggleButton_Click" Width="34" Height="28" Padding="0"
                                        Margin="6,0,0,0" VerticalAlignment="Center" Opacity="1.0"
                                        ToolTip="{Binding [S1626], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                    <views:IconView Icon="expand" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <!-- §113: tombol ▶ jalankan macro yang
                                     dipilih - di sebelah tombol panel. -->
                                <Button x:Name="PlayMacroButton" Grid.Column="5" Click="PlayMacroButton_Click" Width="34" Height="28" Padding="0"
                                        Margin="6,0,0,0" VerticalAlignment="Center"
                                        ToolTip="{Binding [S1629], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                                    <views:IconView Icon="play" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                            <!-- §113: baris jeda 3 detik + info pendek.
                                 Checkbox = pola checkbox Settings yang
                                 sama; info = teks persis 2 kalimat
                                 (teks panjang mockup v2 GUGUR), gaya
                                 ringkas: FontSize 11, warna teks info
                                 mockup #A9C6DE, tanpa kotak/border agar
                                 muat dalam tinggi modal 600 (lihat
                                 pengukuran di laporan Worker C). -->
                            <StackPanel Grid.Row="3" Margin="0,6,0,0">
                                <CheckBox x:Name="Delay3sBox" Content="{Binding [S1627], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center"
                                          IsChecked="True" Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}"
                                          Checked="Delay3sBox_CheckChanged" Unchecked="Delay3sBox_CheckChanged"/>
                                <TextBlock Text="{Binding [S1628], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                           TextWrapping="Wrap" FontSize="11" Foreground="#A9C6DE" FontFamily="{StaticResource CyberTechFont}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- §113: ErrorText + NoticeText satu StackPanel di
                         baris yang sama. Notice (S1630, cyan #5BE4FF -
                         aksen yang sama dengan highlight toggle panel)
                         hanya tampil saat sesi standalone aktif;
                         ShowError menyembunyikannya, HideError
                         mengevaluasi ulang lewat RefreshSessionGating. -->
                    <StackPanel Grid.Row="1">
                        <TextBlock x:Name="ErrorText" Foreground="#F87171" TextWrapping="Wrap"
                                   Margin="0,10,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="NoticeText" Text="{Binding [S1630], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                   Foreground="#5BE4FF" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="CancelButton" Content="{Binding [S0010], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Click="CancelButton_Click" Margin="0,0,8,0" Width="100"/>
                        <Button x:Name="SaveButton" Content="{Binding [S0123], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" Width="100"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </views:ChamferBorder>
    </Grid>
</Window>
