                                    </StackPanel>
                                </Button>
                                <StackPanel x:Name="FilledPrev" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                                    <StackPanel x:Name="KeysPrev" Orientation="Horizontal" VerticalAlignment="Center" Focusable="True" PreviewMouseLeftButtonDown="HotkeyKeys_PreviewMouseLeftButtonDown" PreviewKeyDown="HotkeyKeys_PreviewKeyDown"/>
                                    <Button x:Name="ClearPrev" Width="20" Height="20" Margin="6,0,0,0" VerticalAlignment="Center" Click="HotkeyClear_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="&#x2715;" FontFamily="{StaticResource CyberTechFont}" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- §138: 3 baris macro dipindah dari HotkeyGrid ke grid sendiri;
                             pill/binding/registrasi/guard tidak berubah. -->
                        <Separator Margin="0,18,0,14" Background="#202636"/>
                        <TextBlock Text="{Binding [S1727], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource SectionTitle}"/>
                        <Grid x:Name="MacroHotkeyGrid" Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="280"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Toggle Recording (§137) -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [S1716], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center" FontSize="12.5" FontFamily="{StaticResource CyberTechFont}" Margin="0,0,0,6"/>
                            <Grid Grid.Row="0" Grid.Column="1" Height="36" Margin="0,0,0,6">
                                <Button x:Name="RekamToggleRecording" Style="{StaticResource RecordButton}" Height="36" Padding="12,0" FontSize="12.5" HorizontalAlignment="Left" VerticalAlignment="Center" Click="HotkeyRekam_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="12" Height="12" CornerRadius="2" BorderBrush="#8A93A5" BorderThickness="1.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [S0266], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MerekamToggleRecording" Style="{StaticResource RecordButton}" Tag="recording" Height="36" Padding="12,0" FontSize="12.5" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" Click="HotkeyMerekam_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="DotToggleRecording" Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [S0267], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel x:Name="FilledToggleRecording" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                                    <StackPanel x:Name="KeysToggleRecording" Orientation="Horizontal" VerticalAlignment="Center" Focusable="True" PreviewMouseLeftButtonDown="HotkeyKeys_PreviewMouseLeftButtonDown" PreviewKeyDown="HotkeyKeys_PreviewKeyDown"/>
                                    <Button x:Name="ClearToggleRecording" Width="20" Height="20" Margin="6,0,0,0" VerticalAlignment="Center" Click="HotkeyClear_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="&#x2715;" FontFamily="{StaticResource CyberTechFont}" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Toggle Playback (§137) -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [S1717], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center" FontSize="12.5" FontFamily="{StaticResource CyberTechFont}" Margin="0,0,0,6"/>
                            <Grid Grid.Row="1" Grid.Column="1" Height="36" Margin="0,0,0,6">
                                <Button x:Name="RekamTogglePlayback" Style="{StaticResource RecordButton}" Height="36" Padding="12,0" FontSize="12.5" HorizontalAlignment="Left" VerticalAlignment="Center" Click="HotkeyRekam_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="12" Height="12" CornerRadius="2" BorderBrush="#8A93A5" BorderThickness="1.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [S0266], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MerekamTogglePlayback" Style="{StaticResource RecordButton}" Tag="recording" Height="36" Padding="12,0" FontSize="12.5" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" Click="HotkeyMerekam_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="DotTogglePlayback" Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [S0267], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel x:Name="FilledTogglePlayback" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                                    <StackPanel x:Name="KeysTogglePlayback" Orientation="Horizontal" VerticalAlignment="Center" Focusable="True" PreviewMouseLeftButtonDown="HotkeyKeys_PreviewMouseLeftButtonDown" PreviewKeyDown="HotkeyKeys_PreviewKeyDown"/>
                                    <Button x:Name="ClearTogglePlayback" Width="20" Height="20" Margin="6,0,0,0" VerticalAlignment="Center" Click="HotkeyClear_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="&#x2715;" FontFamily="{StaticResource CyberTechFont}" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Pause/Resume Playback (§137) -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [S1718], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center" FontSize="12.5" FontFamily="{StaticResource CyberTechFont}"/>
                            <Grid Grid.Row="2" Grid.Column="1" Height="36">
                                <Button x:Name="RekamPauseResumePlayback" Style="{StaticResource RecordButton}" Height="36" Padding="12,0" FontSize="12.5" HorizontalAlignment="Left" VerticalAlignment="Center" Click="HotkeyRekam_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="12" Height="12" CornerRadius="2" BorderBrush="#8A93A5" BorderThickness="1.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [S0266], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MerekamPauseResumePlayback" Style="{StaticResource RecordButton}" Tag="recording" Height="36" Padding="12,0" FontSize="12.5" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" Click="HotkeyMerekam_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="DotPauseResumePlayback" Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [S0267], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel x:Name="FilledPauseResumePlayback" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                                    <StackPanel x:Name="KeysPauseResumePlayback" Orientation="Horizontal" VerticalAlignment="Center" Focusable="True" PreviewMouseLeftButtonDown="HotkeyKeys_PreviewMouseLeftButtonDown" PreviewKeyDown="HotkeyKeys_PreviewKeyDown"/>
                                    <Button x:Name="ClearPauseResumePlayback" Width="20" Height="20" Margin="6,0,0,0" VerticalAlignment="Center" Click="HotkeyClear_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="&#x2715;" FontFamily="{StaticResource CyberTechFont}" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <TextBlock Text="{Binding [S0272], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                   Style="{StaticResource Hint}" Margin="0,0,0,8"/>


                        <Separator Margin="0,18,0,14" Background="#202636"/>
                        <TextBlock Text="{Binding [S0278], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding IconStatsText}" TextWrapping="Wrap" FontSize="12.5" FontFamily="{StaticResource CyberTechFont}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding [S0279], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5" FontFamily="{StaticResource CyberTechFont}"/>
                            <TextBox Text="{Binding IconMaxKbText}" Width="120" FontFamily="{StaticResource CyberTechFont}"/>
                            <TextBlock Text="{Binding [S0280], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12.5" FontFamily="{StaticResource CyberTechFont}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding [S0281], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                   Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                        <CheckBox Content="{Binding [S0282], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" IsChecked="{Binding AutoFetchIcons}" Margin="0,10,0,0" Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}"/>
                        <TextBlock Text="{Binding [S0283], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                   Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                        <CheckBox Content="{Binding [S0284], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" IsChecked="{Binding CleanOrphans}" Margin="0,10,0,0" Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}"/>
                        <CheckBox Content="{Binding [S0285], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" IsChecked="{Binding CleanAllIcons}" Margin="0,6,0,0" Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}"/>
                        <Button Content="{Binding [S0286], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding CleanIconsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="18,6"/>
                        <TextBlock Text="{Binding IconMessageText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="#FCA5A5" FontSize="12" FontFamily="{StaticResource CyberTechFont}"
                                   Visibility="{Binding HasIconMessage, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding [S0287], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                   Style="{StaticResource Hint}" Margin="0,6,0,0"/>

                        <Separator Margin="0,18,0,14" Background="#202636"/>
                        <TextBlock Text="OBS Studio" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding ObsStatusText, StringFormat='Status: {0}'}" TextWrapping="Wrap" FontSize="13" FontFamily="{StaticResource CyberTechFont}"/>
                        <TextBlock Text="{Binding ObsFailureReasonText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="#FCA5A5" FontSize="12" FontFamily="{StaticResource CyberTechFont}"
                                   Visibility="{Binding HasObsFailureReason, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding [S0288], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="0,8,0,3" Opacity="0.75" FontSize="12" FontFamily="{StaticResource CyberTechFont}"/>
                        <TextBox Text="{Binding ObsHost}" FontFamily="{StaticResource CyberTechFont}" FontSize="13" Height="36" Width="280" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding [S0245], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="0,8,0,3" Opacity="0.75" FontSize="12" FontFamily="{StaticResource CyberTechFont}"/>
                        <TextBox Text="{Binding ObsPassword}" FontFamily="{StaticResource CyberTechFont}" FontSize="13" Height="36" Width="280" HorizontalAlignment="Left"/>
                        <!-- §174: tombol Hubungkan/Putuskan warna
                             NORMAL (GhostButton, seperti tombol
                             tetangga) + DOT status: merah saat putus,
                             hijau saat terhubung. Mekanisme
                             visibility-swap + label + command tidak
                             berubah. -->
                        <Button Command="{Binding ToggleObsConnectionCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#EF4444"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsObsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="#3DDC84"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding [S0174], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsObsConnected}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding ToggleObsConnectionCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#EF4444"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsObsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="#3DDC84"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding [S1835], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsObsConnected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="{Binding ObsMessageText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="#FCA5A5" FontSize="12" FontFamily="{StaticResource CyberTechFont}"
                                   Visibility="{Binding HasObsMessage, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding [S0247], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                   Style="{StaticResource Hint}" Margin="0,6,0,0"/>

                        <!-- §147 Streamer.bot: cermin seksi OBS di atas
                             (judul, status biner, baris alasan menetap,
                             kolom Width 280/Height 36/Left - Port 120,
                             tombol hubung/putus, baris pesan). Baris
                             OBS di atas tidak berubah. -->
                        <Separator Margin="0,18,0,14" Background="#202636"/>
                        <TextBlock Text="{Binding [S1743], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding StreamerBotStatusText, StringFormat='Status: {0}'}" TextWrapping="Wrap" FontSize="13" FontFamily="{StaticResource CyberTechFont}"/>
                        <TextBlock Text="{Binding StreamerBotFailureReasonText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="#FCA5A5" FontSize="12" FontFamily="{StaticResource CyberTechFont}"
                                   Visibility="{Binding HasStreamerBotFailureReason, Converter={StaticResource BoolVis}}"/>
                        <!-- §148-B3/B4: grid 2×2 menggantikan empat field
                             bertumpuk - ColumnDefinitions IDENTIK dengan
                             grid tab Streamer.bot di ObsConfigWindow
                             (2* / 8 / 1*), baris Auto + spacer 8 + Auto;
                             binding/label/Height 36 sama, label di atas
                             field di tiap sel. Total Width 280 = kolom
                             OBS di atas. Status/alasan/tombol/pesan di
                             luar grid tidak berubah. -->
                        <Grid Width="280" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="{Binding [S1744], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="0,0,0,3" Opacity="0.75" FontSize="12" FontFamily="{StaticResource CyberTechFont}"/>
                                <TextBox Text="{Binding StreamerBotHost}" FontFamily="{StaticResource CyberTechFont}" FontSize="13" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="{Binding [S1745], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="0,0,0,3" Opacity="0.75" FontSize="12" FontFamily="{StaticResource CyberTechFont}"/>
                                <TextBox Text="{Binding StreamerBotPortText}" FontFamily="{StaticResource CyberTechFont}" FontSize="13" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="{Binding [S1746], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="0,0,0,3" Opacity="0.75" FontSize="12" FontFamily="{StaticResource CyberTechFont}"/>
                                <TextBox Text="{Binding StreamerBotEndpoint}" FontFamily="{StaticResource CyberTechFont}" FontSize="13" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="{Binding [S1747], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="0,0,0,3" Opacity="0.75" FontSize="12" FontFamily="{StaticResource CyberTechFont}"/>
                                <TextBox Text="{Binding StreamerBotPassword}" FontFamily="{StaticResource CyberTechFont}" FontSize="13" Height="36"/>
                            </StackPanel>
                        </Grid>
                        <!-- §174: tombol Hubungkan/Putuskan Streamer.bot
                             warna NORMAL (GhostButton) + DOT status
                             (merah putus / hijau terhubung), seperti
                             pasangan OBS di atas. Mekanisme, label,
                             dan command tidak berubah. Keterangan
                             S1748 pindah ke bawah tombol (sebelum
                             baris pesan). -->
                        <Button Command="{Binding ToggleStreamerBotConnectionCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#EF4444"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStreamerBotConnected}" Value="True">
                                                        <Setter Property="Fill" Value="#3DDC84"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding [S0174], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStreamerBotConnected}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding ToggleStreamerBotConnectionCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#EF4444"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStreamerBotConnected}" Value="True">
                                                        <Setter Property="Fill" Value="#3DDC84"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding [S1835], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStreamerBotConnected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="{Binding [S1748], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                   Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding StreamerBotMessageText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="#FCA5A5" FontSize="12" FontFamily="{StaticResource CyberTechFont}"
                                   Visibility="{Binding HasStreamerBotMessage, Converter={StaticResource BoolVis}}"/>

                        <!-- §137 Log Level: dropdown mengikuti pola
                             ComboBoxItem+Tag+SelectedValue di
                             BindingEditorWindow.xaml:1091 (nilai kanonis
                             Inggris di Tag, label lokal di Content); style
                             global ComboBox di App.xaml memberi FontSize
                             12.5/MinHeight 30, jadi di sini hanya Width +
                             perataan kiri. §139: seksi ini dipindah ke
                             PALING BAWAH, sesudah seksi OBS (§140: seksi
                             Browser pindah ke Kelola Grup Browser). -->
                        <Separator Margin="0,18,0,14" Background="#202636"/>
                        <TextBlock Text="{Binding [S1722], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding [S1723], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                   Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding LogLevel, Mode=TwoWay}" Width="280" HorizontalAlignment="Left">
                            <ComboBoxItem Content="{Binding [S1724], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Tag="Debug"/>
                            <ComboBoxItem Content="{Binding [S1725], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Tag="Information"/>
                            <ComboBoxItem Content="{Binding [S1726], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Tag="Warning"/>
                            <ComboBoxItem Content="{Binding [S0841], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Tag="Error"/>
                        </ComboBox>
                        <!-- §143: Grid 136+8+136=280 - dua tombol sama lebar,
                             tepi kiri/kanan rata dengan dropdown Width 280 di
                             atasnya. Kolom tengah 8px adalah gap; Margin 8
                             antar-tombol dari StackPanel lama dihapus karena
                             gap kini struktural (dua kolom "*" + Margin 8
                             akan memberi tombol 140 vs 132, tidak sama). -->
                        <Grid Width="280" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="136"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="136"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{Binding [S1730], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding OpenLogFolderCommand}" Padding="18,6" HorizontalAlignment="Stretch"/>
                            <Button Grid.Column="2" Content="{Binding [S1731], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding ClearLogCommand}" Padding="18,6" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <TextBlock Text="{Binding LogMessageText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="#FCA5A5" FontSize="12" FontFamily="{StaticResource CyberTechFont}"
                                   Visibility="{Binding HasLogMessage, Converter={StaticResource BoolVis}}"/>
                    

                        <!-- §171 Pembaruan: pindahan tombol "Periksa
                             Pembaruan" dari About (§166) lewat jalur
                             bersama UpdateChecker - PALING BAWAH,
                             sesudah Log Level, di dalam ScrollViewer
                             yang sama; footer statis (§130) tidak
                             berubah. §173: tampilan disederhanakan -
                             hanya checkbox + versi terpasang + rilis
                             terbaru + tombol Periksa; tautan halaman
                             rilis tetap ada di dialog hasil periksa.
                             Tanpa penomoran versi formal, "baru"
                             berarti tag berubah saja. -->
                        <Separator Margin="0,18,0,14" Background="#202636"/>
                        <TextBlock Text="{Binding [S1812], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Content="{Binding [S1813], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" IsChecked="{Binding AutoCheckUpdates}" Margin="0,0,0,0" Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}"/>
                        <TextBlock Text="{Binding UpdateInstalledText}" TextWrapping="Wrap" FontSize="13" FontFamily="{StaticResource CyberTechFont}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding UpdateLatestText}" TextWrapping="Wrap" FontSize="13" FontFamily="{StaticResource CyberTechFont}" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="CheckUpdateButton" Content="{Binding [S1777], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Click="CheckUpdate_Click"
                                    HorizontalAlignment="Left" Padding="18,6"/>
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateMessageText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="#FCA5A5" FontSize="12" FontFamily="{StaticResource CyberTechFont}"
                                   Visibility="{Binding HasUpdateMessage, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- §130: footer TETAP di luar ScrollViewer (pola
                     BrowserManagerWindow Grid.Row=2): tombol Simpan
                     + pesan Save yang dulu tenggelam di ujung scroll
                     kini selalu terlihat; Batal lewat Close_Click
                     yang sama dengan × sehingga konfirmasi §104/§105
                     tetap berjalan; Reset Data di kiri. -->
                <Border Grid.Row="2" Background="#0E121A" BorderBrush="#1C2433" BorderThickness="0,1,0,0" Padding="18,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding [S1685], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                Style="{StaticResource DangerButton}" Click="ResetData_Click"
                                Padding="22,8" FontFamily="{StaticResource CyberTechFont}" FontSize="13.5" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="{Binding SaveMessageText}" TextWrapping="Wrap" Margin="12,0" VerticalAlignment="Center"
                                   Foreground="#FCA5A5" FontSize="12" FontFamily="{StaticResource CyberTechFont}"
                                   Visibility="{Binding HasSaveMessage, Converter={StaticResource BoolVis}}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="{Binding [S0010], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Click="Close_Click"
                                    Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                    Padding="22,8" FontFamily="{StaticResource CyberTechFont}" FontSize="13.5" FontWeight="Bold"/>
                            <Button Content="{Binding [S0123], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding SaveAllCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="22,8" FontFamily="{StaticResource CyberTechFont}" FontSize="13.5" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </views:ChamferBorder>
    </Grid>
</Window>
