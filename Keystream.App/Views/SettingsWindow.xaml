<Window WindowStyle="None" x:Class="Keystream.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Keystream.App.Views"
        xmlns:loc="clr-namespace:Keystream.App.Localization"
        Title="{Binding [S0230], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Height="660" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Foreground="#E8EAF0"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource CyberTechFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Base" CornerRadius="5"
                                Background="#10131C"
                                BorderBrush="#222B3A"
                                BorderThickness="1,1,1,2">
                            <Border x:Name="Face" CornerRadius="4"
                                    Margin="1,1,1,1"
                                    BorderBrush="#3D4B63"
                                    BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2C374A" Offset="0.0"/>
                                        <GradientStop Color="#1A212E" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#38465D" Offset="0.0"/>
                                            <GradientStop Color="#232B3B" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#5B7093"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#181F2B" Offset="0.0"/>
                                            <GradientStop Color="#121721" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecordButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource CyberTechFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Base" CornerRadius="5"
                                Background="#10141E"
                                BorderBrush="#222B3A"
                                BorderThickness="1,1,1,1.5">
                            <Border x:Name="Face" CornerRadius="4"
                                    Margin="1"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    Background="#1A212E"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#253043"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#151B25"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="recording">
                                <Setter TargetName="Face" Property="Background" Value="#3A171A"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="#FCA5A5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource CyberTechFont}"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontFamily" Value="{StaticResource CyberTechFont}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Kedip indikator ● REKAM saat merekam (satu storyboard untuk
             keempat overlay; dijalankan/dihentikan dari code-behind). -->
        <Storyboard x:Key="RecBlink" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="DotPanic" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.55" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="DotGlobal" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.55" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="DotNext" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.55" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="DotPrev" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.55" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="DotToggleRecording" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.55" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="DotTogglePlayback" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.55" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="DotPauseResumePlayback" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.55" AutoReverse="True"/>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="14">
        <!-- Shadow proxy layer: isolated shadow layer, prevents text blur and border artifacts -->
        <Border CornerRadius="16" Background="#0A0C14" Margin="2">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.8" BlurRadius="16" ShadowDepth="4" Direction="315"/>
            </Border.Effect>
        </Border>

        <views:ChamferBorder Chamfer="20" ClipChild="True"
                             Background="{StaticResource WindowBackgroundBrush}"
                             BorderBrush="{StaticResource ChassisMilledBevelBrush}"
                             InnerBevelBrush="{StaticResource ChassisInnerBevelBrush}"
                             BorderThickness="3.0"
                             SpecularTopHighlight="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="#1E86E0" BorderThickness="0,0,0,1.5"
                        Background="{StaticResource HeaderBackgroundBrush}"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Height="46" Margin="18,0,12,0">
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="15" FontWeight="Bold" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ShellChromeButton}" HorizontalAlignment="Right"
                                Click="Close_Click" ToolTip="{Binding [S0003], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                            <TextBlock Text="&#x2715;" FontSize="11" FontFamily="{StaticResource CyberTechFont}" FontWeight="SemiBold" Foreground="#B9C1D1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,24">
                        <TextBlock Text="{Binding [S0256], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <!-- Nama bisa diklik: buka modal pilih keyboard deck. -->
                            <TextBlock Text="{Binding DeckText}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13.5" FontFamily="{StaticResource CyberTechFont}"
                                       Cursor="Hand" ToolTip="{Binding [S0257], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" PreviewMouseLeftButtonDown="DeckName_PreviewMouseLeftButtonDown">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                                <Setter Property="Foreground" Value="#38BDF8"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="!" Width="22" Height="22" Margin="8,0,0,0" Padding="0"
                                    FontWeight="Bold" ToolTip="{Binding [S0259], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                    Command="{Binding ToggleDeckDetailCommand}"/>
                        </StackPanel>
                        <Border Background="#141721" BorderBrush="#262D3D" BorderThickness="1" CornerRadius="6"
                                Padding="10" Margin="0,8,0,0"
                                Visibility="{Binding ShowDeckDetail, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding DeckDetailText}" TextWrapping="Wrap" FontSize="12" FontFamily="{StaticResource CyberTechFont}" Opacity="0.85"/>
                        </Border>
                        <!-- Indikator sejajar: label kolom tetap 140 agar
                             nilai kedua baris mulai di x yang sama. -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [S0260], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Opacity="0.75" FontSize="12" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ServiceStatusText}" TextWrapping="Wrap"
                                       Foreground="{Binding ServiceStatusBrush}" FontWeight="Bold" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [S0261], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Opacity="0.75" FontSize="12" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding DriverStatusText}" TextWrapping="Wrap" FontSize="12" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Pesan operasi seksi Keyboard Deck (ToggleService
                             gagal) - §128: tiap seksi punya pesan sendiri
                             yang hilang sendiri setelah 3,5 detik. -->
                        <TextBlock Text="{Binding DeckMessageText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="#FCA5A5" FontSize="12" FontFamily="{StaticResource CyberTechFont}"
                                   Visibility="{Binding HasDeckMessage, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding MasterHotkeyFailuresText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="#FCA5A5" FontSize="12" FontFamily="{StaticResource CyberTechFont}"
                                   Visibility="{Binding HasMasterHotkeyFailures, Converter={StaticResource BoolVis}}"/>
                        <!-- Pasangan tombol simetris, pola yang sama
                             dengan tombol Log (§143) dan Ekspor/Impor
                             (§173b): Grid 136+8+136=280, tepi rata
                             dengan dropdown Width 280; gap struktural
                             8, tombol Stretch, Padding 18,6. Dulu
                             total 368 (kolom "*") — terlalu lebar,
                             disamakan dengan tombol lain. §174: label
                             S0262 dipendekkan menjadi "Identifikasi". -->
                        <Grid Width="280" HorizontalAlignment="Left" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="136"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="136"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{Binding [S0262], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding IdentifyDeckCommand}" Padding="18,6" HorizontalAlignment="Stretch"/>
                            <!-- §173: tombol service mengikuti status hidup -
                                 SATU kontrol terlihat: jalan = "Stop" merah
                                 (DangerButton), berhenti = "Mulai" hijau
                                 (SuccessButton); nonaktif saat Starting.
                                 Label via S0674 ("Stop") + S1834 ("Mulai"). -->
                            <Button Grid.Column="2" Content="{Binding [S1834], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding ToggleServiceCommand}"
                                    IsEnabled="{Binding IsServiceButtonEnabled}" Padding="18,6" HorizontalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServiceRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="2" Content="{Binding [S0674], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding ToggleServiceCommand}"
                                    IsEnabled="{Binding IsServiceButtonEnabled}" Padding="18,6" HorizontalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServiceRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <Separator Margin="0,18,0,14" Background="#202636"/>
                        <TextBlock Text="{Binding [S0273], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource SectionTitle}"/>
                        <!-- §141: dropdown Bahasa - kontrol pertama seksi ini,
                             staged seperti Log Level (berlaku saat Simpan
                             Semua via Localizer.SetLanguage yang sama
                             dengan dropdown bahasa title-bar; tanpa
                             live-apply saat dipilih). Item dari registry
                             Localizer (12 bahasa, urutan kanonis) via
                             LanguageOptions; endonym adalah proper noun
                             literal, tanpa kunci string, tidak
                             diterjemahkan ulang saat pilihan berubah. -->
                        <TextBlock Text="{Binding [S1741], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding [S1742], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                   Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedValuePath="Code" SelectedValue="{Binding Language, Mode=TwoWay}" Width="280" HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Endonym}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox Content="{Binding [S0274], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" IsChecked="{Binding StartWithWindows}" Margin="0,8,0,0" Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}"/>
                        <CheckBox Content="{Binding [S0275], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" IsChecked="{Binding StartMinimized}" Margin="0,6,0,0" Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}"/>
                        <CheckBox Content="{Binding [S1845], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" IsChecked="{Binding AlwaysOnTop}" Margin="0,6,0,0" Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}"/>
                        <CheckBox Content="{Binding [S1846], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" IsChecked="{Binding PlaySoundOnPress}" Margin="0,6,0,0" Foreground="#E8EAF0" FontFamily="{StaticResource CyberTechFont}"/>
                        <!-- §173b: pasangan tombol simetris seperti tombol Log
                             (§143) - Grid 136+8+136=280, tepi rata dengan
                             dropdown Width 280; gap struktural 8, bukan
                             Margin antar-tombol. Label Ekspor via S0276
                             ("Export Profile", tanpa suffix). -->
                        <Grid Width="280" HorizontalAlignment="Left" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="136"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="136"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{Binding [S0276], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding ExportProfileCommand}" Padding="18,6" HorizontalAlignment="Stretch"/>
                            <Button Grid.Column="2" Content="{Binding [S0277], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding ImportProfileCommand}" Padding="18,6" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Button Content="{Binding [S1847], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Command="{Binding OpenConfigFolderCommand}" Width="280" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="18,6"/>
                        <TextBlock Text="{Binding ProfileMessageText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="#FCA5A5" FontSize="12" FontFamily="{StaticResource CyberTechFont}"
                                   Visibility="{Binding HasProfileMessage, Converter={StaticResource BoolVis}}"/>
                        <Separator Margin="0,18,0,14" Background="#202636"/>
                        <TextBlock Text="{Binding [S0264], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource SectionTitle}"/>
                        <Grid x:Name="HotkeyGrid" Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="280"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Panic Passthrough -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [S0265], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center" FontSize="12.5" FontFamily="{StaticResource CyberTechFont}" Margin="0,0,0,6"/>
                            <!-- Slot Panic: tanpa kolom input. Kosong = tombol
                                 Rekam, merekam = pill Merekam (titik kedip,
                                 tanpa "..."), terisi = keycap per tombol + ×. -->
                            <Grid Grid.Row="0" Grid.Column="1" Height="36" Margin="0,0,0,6">
                                <Button x:Name="RekamPanic" Style="{StaticResource RecordButton}" Height="36" Padding="12,0" FontSize="12.5" HorizontalAlignment="Left" VerticalAlignment="Center" Click="HotkeyRekam_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="12" Height="12" CornerRadius="2" BorderBrush="#8A93A5" BorderThickness="1.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [S0266], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MerekamPanic" Style="{StaticResource RecordButton}" Tag="recording" Height="36" Padding="12,0" FontSize="12.5" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" Click="HotkeyMerekam_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="DotPanic" Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [S0267], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel x:Name="FilledPanic" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                                    <StackPanel x:Name="KeysPanic" Orientation="Horizontal" VerticalAlignment="Center" Focusable="True" PreviewMouseLeftButtonDown="HotkeyKeys_PreviewMouseLeftButtonDown" PreviewKeyDown="HotkeyKeys_PreviewKeyDown"/>
                                    <Button x:Name="ClearPanic" Width="20" Height="20" Margin="6,0,0,0" VerticalAlignment="Center" Click="HotkeyClear_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="&#x2715;" FontFamily="{StaticResource CyberTechFont}" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Toggle Global -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [S0269], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center" FontSize="12.5" FontFamily="{StaticResource CyberTechFont}" Margin="0,0,0,6"/>
                            <Grid Grid.Row="1" Grid.Column="1" Height="36" Margin="0,0,0,6">
                                <Button x:Name="RekamGlobal" Style="{StaticResource RecordButton}" Height="36" Padding="12,0" FontSize="12.5" HorizontalAlignment="Left" VerticalAlignment="Center" Click="HotkeyRekam_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="12" Height="12" CornerRadius="2" BorderBrush="#8A93A5" BorderThickness="1.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [S0266], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MerekamGlobal" Style="{StaticResource RecordButton}" Tag="recording" Height="36" Padding="12,0" FontSize="12.5" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" Click="HotkeyMerekam_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="DotGlobal" Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [S0267], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel x:Name="FilledGlobal" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                                    <StackPanel x:Name="KeysGlobal" Orientation="Horizontal" VerticalAlignment="Center" Focusable="True" PreviewMouseLeftButtonDown="HotkeyKeys_PreviewMouseLeftButtonDown" PreviewKeyDown="HotkeyKeys_PreviewKeyDown"/>
                                    <Button x:Name="ClearGlobal" Width="20" Height="20" Margin="6,0,0,0" VerticalAlignment="Center" Click="HotkeyClear_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="&#x2715;" FontFamily="{StaticResource CyberTechFont}" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Next Profile -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [S0270], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center" FontSize="12.5" FontFamily="{StaticResource CyberTechFont}" Margin="0,0,0,6"/>
                            <Grid Grid.Row="2" Grid.Column="1" Height="36" Margin="0,0,0,6">
                                <Button x:Name="RekamNext" Style="{StaticResource RecordButton}" Height="36" Padding="12,0" FontSize="12.5" HorizontalAlignment="Left" VerticalAlignment="Center" Click="HotkeyRekam_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="12" Height="12" CornerRadius="2" BorderBrush="#8A93A5" BorderThickness="1.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [S0266], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MerekamNext" Style="{StaticResource RecordButton}" Tag="recording" Height="36" Padding="12,0" FontSize="12.5" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" Click="HotkeyMerekam_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="DotNext" Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center"/>
