                            </Grid>

                            <!-- Prev Profile -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [S0271], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" VerticalAlignment="Center" FontSize="12.5" FontFamily="{StaticResource CyberTechFont}" Margin="0,0,0,6"/>
                            <Grid Grid.Row="3" Grid.Column="1" Height="36" Margin="0,0,0,6">
                                <Button x:Name="RekamPrev" Style="{StaticResource RecordButton}" Height="36" Padding="12,0" FontSize="12.5" HorizontalAlignment="Left" VerticalAlignment="Center" Click="HotkeyRekam_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="12" Height="12" CornerRadius="2" BorderBrush="#8A93A5" BorderThickness="1.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding [S0266], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MerekamPrev" Style="{StaticResource RecordButton}" Tag="recording" Height="36" Padding="12,0" FontSize="12.5" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" Click="HotkeyMerekam_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="DotPrev" Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center"/>
