<Window WindowStyle="None" x:Class="Keystream.App.Views.WaitingKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Keystream.App.Views"
        xmlns:loc="clr-namespace:Keystream.App.Localization"
        Title="{Binding [S0237], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Width="510" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Foreground="#E8EAF0"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="14">
        <!-- Shadow proxy layer: isolated shadow layer, prevents text blur and border artifacts -->
        <Border CornerRadius="16" Background="#0A0C14" Margin="2">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.8" BlurRadius="16" ShadowDepth="4" Direction="315"/>
            </Border.Effect>
        </Border>

        <!-- Main Chamfered Dialog Box: clips child content with precision -->
        <views:ChamferBorder Chamfer="20" ClipChild="True"
                             Background="{StaticResource WindowBackgroundBrush}"
                             BorderBrush="{StaticResource ChassisMilledBevelBrush}"
                             InnerBevelBrush="{StaticResource ChassisInnerBevelBrush}"
                             BorderThickness="3.0"
                             SpecularTopHighlight="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Modal Header -->
                <Border Grid.Row="0" BorderBrush="#1E86E0" BorderThickness="0,0,0,1.5"
                        Background="{StaticResource HeaderBackgroundBrush}"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Height="46" Margin="18,0,12,0">
                        <TextBlock x:Name="TitleBlock" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="15" FontWeight="Bold" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ShellChromeButton}" HorizontalAlignment="Right"
                                Click="Close_Click" ToolTip="{Binding [S0003], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                            <TextBlock Text="&#x2715;" FontSize="11" FontFamily="{StaticResource CyberTechFont}" FontWeight="SemiBold" Foreground="#B9C1D1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Modal Body -->
                <StackPanel Grid.Row="1" Margin="24,20,24,24">
                    <!-- Keycap visual replaces the spinning loader:
                         live pending cap: the modifiers held so far
                         ("CTRL", "CTRL+SHIFT") via CapturePendingCap
                         on the MainViewModel; "…" while nothing is
                         held. The completed chord never paints here:
                         the modal closes on the main key's DOWN and
                         the chord shows in the editor. Keycap bezel,
                         gradient and glow copied from the editor
                         header keycap. -->
                    <Border Width="54" Height="48" CornerRadius="7" Opacity="0.5" HorizontalAlignment="Center"
                            Background="#161B26" BorderBrush="#364357" BorderThickness="1.5,1.5,3,3">
                        <Border Margin="2,2,3,4" CornerRadius="5"
                                BorderBrush="#475569" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2C374A" Offset="0"/>
                                    <GradientStop Color="#181E2B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2">
                                <Viewbox MaxWidth="42" MaxHeight="26" Stretch="Uniform">
                                    <TextBlock Text="{Binding CapturePendingCap}"
                                               FontSize="17" FontWeight="Bold"
                                               Foreground="#5BE4FF"
                                               FontFamily="{StaticResource CyberTitleFont}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#38BDF8" BlurRadius="6" ShadowDepth="0" Opacity="0.75"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </Border>
                    <TextBlock x:Name="PromptTitleBlock" Text="{Binding [S0300], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" FontSize="14.5" FontWeight="Bold" FontFamily="{StaticResource CyberTechFont}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock x:Name="PromptDescBlock" Text="{Binding [S0301], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Opacity="0.6" FontSize="12" FontFamily="{StaticResource CyberTechFont}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                    <Button Content="{Binding [S0010], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource GhostButton}" Width="120" HorizontalAlignment="Center" Margin="0,20,0,0"
                            Padding="12,6" Click="Cancel_Click" FontFamily="{StaticResource CyberTechFont}" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </views:ChamferBorder>
    </Grid>
</Window>
