<Window WindowStyle="None" x:Class="Keystream.App.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Keystream.App.Views"
        xmlns:loc="clr-namespace:Keystream.App.Localization"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent" Foreground="#E8EAF0"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource CyberTechFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Base" CornerRadius="5"
                                Background="#10131C"
                                BorderBrush="#222B3A"
                                BorderThickness="1,1,1,2">
                            <Border x:Name="Face" CornerRadius="4"
                                    Margin="1,1,1,1"
                                    BorderBrush="#3D4B63"
                                    BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2C374A" Offset="0.0"/>
                                        <GradientStop Color="#1A212E" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#38465D" Offset="0.0"/>
                                            <GradientStop Color="#232B3B" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#5B7093"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#181F2B" Offset="0.0"/>
                                            <GradientStop Color="#121721" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource CyberTechFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Base" CornerRadius="5"
                                Background="#08233C"
                                BorderBrush="#175084"
                                BorderThickness="1,1,1,2">
                            <Border x:Name="Face" CornerRadius="4"
                                    Margin="1,1,1,1"
                                    BorderBrush="#4FA6F7"
                                    BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2596F8" Offset="0.0"/>
                                        <GradientStop Color="#1570BD" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#38A8FF" Offset="0.0"/>
                                            <GradientStop Color="#1E86E0" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#7EC8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1264A8" Offset="0.0"/>
                                            <GradientStop Color="#0E4E88" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <!-- Shadow proxy layer: isolated shadow layer, prevents text blur and border artifacts -->
        <Border CornerRadius="16" Background="#0A0C14" Margin="2">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.8" BlurRadius="16" ShadowDepth="4" Direction="315"/>
            </Border.Effect>
        </Border>

        <!-- Main Chamfered Dialog Box -->
        <views:ChamferBorder Chamfer="20" ClipChild="True"
                             Background="{StaticResource WindowBackgroundBrush}"
                             BorderBrush="{StaticResource ChassisMilledBevelBrush}"
                             InnerBevelBrush="{StaticResource ChassisInnerBevelBrush}"
                             BorderThickness="3.0"
                             SpecularTopHighlight="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Modal Header -->
                <Border Grid.Row="0" BorderBrush="#1E86E0" BorderThickness="0,0,0,1.5"
                        Background="{StaticResource HeaderBackgroundBrush}"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Height="46" Margin="18,0,12,0">
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="15" FontWeight="Bold" FontFamily="{StaticResource CyberTechFont}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ShellChromeButton}" HorizontalAlignment="Right"
                                Click="Close_Click" ToolTip="{Binding [S0003], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}">
                            <TextBlock Text="&#x2715;" FontSize="11" FontFamily="{StaticResource CyberTechFont}" FontWeight="SemiBold" Foreground="#B9C1D1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
                <!-- Modal Body -->
                <StackPanel Grid.Row="1" Margin="24,20,24,20">
                    <StackPanel Orientation="Horizontal">
                        <views:IconView x:Name="KindIcon" Width="32" Height="32" VerticalAlignment="Top"/>
                        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13.5" FontFamily="{StaticResource CyberTechFont}" Margin="14,2,0,0" Width="340"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="CancelButton" Content="{Binding [S0010], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="0,0,8,0" Click="Cancel_Click"/>
                        <Button x:Name="NoButton" Content="{Binding [S0175], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Margin="0,0,8,0" Click="No_Click"/>
                        <Button x:Name="YesButton" Content="{Binding [S0176], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}" Style="{StaticResource DialogPrimary}" Click="Yes_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </views:ChamferBorder>
    </Grid>
</Window>
