<Application x:Class="Keystream.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:views="clr-namespace:Keystream.App.Views"
        xmlns:loc="clr-namespace:Keystream.App.Localization"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Scrollbar thickness for EVERY bar in the app, including the
             ones inside ListBox/ComboBox templates: those size themselves
             from these system metric keys, which can outrank the ScrollBar
             style below - overriding the keys is what makes the thin
             pattern hold everywhere (v2.9.28). -->
        <system:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">7</system:Double>
        <system:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">7</system:Double>
        <views:HexGradientConverter x:Key="HexGradient"/>
        <views:HexInkConverter x:Key="HexInk"/>

        <!-- Thin dark scrollbars app-wide (default WPF bars render white). -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBd" Background="#3A4152" CornerRadius="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#5A6B8C"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="6"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark dropdowns app-wide (default WPF combos render white). -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3247"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D4A6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E222D"/>
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="BorderBrush" Value="#3A4152"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="MinHeight" Value="30"/>
            <!-- Popup discipline: the drop-down is EXACTLY as wide as its
                 combo (never stretched wider by long items, which pushed
                 it past the window/screen edge) and at most 240 tall,
                 scrolling inside beyond that. Placement stays Bottom,
                 which flips above the combo when the screen edge is near. -->
            <Setter Property="MaxDropDownHeight" Value="240"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#1E222D" BorderBrush="#3A4152" BorderThickness="2" CornerRadius="6">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#B9C1D1" StrokeThickness="1.6"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,26,0" VerticalAlignment="Center"/>
                            <!-- Placeholder "Belum memilih" (25 Okt 2026):
                                 tampil saat tidak ada yang dipilih, dari Tag
                                 - BUKAN item di daftar (item "Belum memilih"
                                 yang bisa dipilih adalah logika cacad: tidak
                                 ada gunanya pengguna memilih opsi itu).
                                 ComboBox tanpa Tag tidak berubah (teks kosong). -->
                            <TextBlock x:Name="PlaceholderText" IsHitTestVisible="False"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#5D6980"
                                       FontSize="{TemplateBinding FontSize}"
                                       Margin="10,0,26,0" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" Foreground="#E8EAF0" BorderThickness="0"
                                     Margin="8,0,26,0" VerticalAlignment="Center"/>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="#1B1F28" BorderBrush="#3A4152" BorderThickness="1" CornerRadius="6"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="SelectedItem" Value="{x:Null}"/>
                                    <Condition Property="IsEditable" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Futuristic Cyber Typography -->
        <FontFamily x:Key="CyberTitleFont">pack://application:,,,/Keystream;component/Assets/#Orbitron, Bahnschrift, Rajdhani, Segoe UI</FontFamily>
        <FontFamily x:Key="CyberTechFont">pack://application:,,,/Keystream;component/Assets/#Rajdhani, Bahnschrift, Segoe UI Variable Display, Segoe UI</FontFamily>

        <SolidColorBrush x:Key="AccentBrush" Color="#1E86E0"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1B1F28"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#2E3547"/>

        <!-- Thick Sculpted CNC Milled Bevel Brushes (Identical to Reference Hardware Deck) -->
        <LinearGradientBrush x:Key="ChassisMilledBevelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#96A0B2" Offset="0"/>
            <GradientStop Color="#5A6477" Offset="0.45"/>
            <GradientStop Color="#303746" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ChassisBorderBrush" Color="#4A5469"/>
        <SolidColorBrush x:Key="ChassisInnerBevelBrush" Color="#1E2533"/>

        <LinearGradientBrush x:Key="CardMilledBevelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#68768E" Offset="0"/>
            <GradientStop Color="#394254" Offset="0.5"/>
            <GradientStop Color="#202530" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#363F52"/>
        <SolidColorBrush x:Key="CardInnerBevelBrush" Color="#171A24"/>

        <!-- Subtle gunmetal bevel brush replacing harsh static diagonal gradient -->
        <LinearGradientBrush x:Key="MetallicFrameBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5A6477" Offset="0"/>
            <GradientStop Color="#2D3443" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#12151D" Offset="0"/>
            <GradientStop Color="#0E1016" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#161922" Offset="0"/>
            <GradientStop Color="#11131A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="KeystreamTitleGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#5BE4FF" Offset="0.55"/>
            <GradientStop Color="#1E86E0" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Base" CornerRadius="6"
                                Background="#08233C"
                                BorderBrush="#175084"
                                BorderThickness="1,1,1,2">
                            <Border x:Name="Face" CornerRadius="5"
                                    Margin="1,1,1,1"
                                    BorderBrush="#4FA6F7"
                                    BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2596F8" Offset="0.0"/>
                                        <GradientStop Color="#1570BD" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#38A8FF" Offset="0.0"/>
                                            <GradientStop Color="#1E86E0" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#7EC8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1264A8" Offset="0.0"/>
                                            <GradientStop Color="#0E4E88" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Base" CornerRadius="6"
                                Background="#10131C"
                                BorderBrush="#222B3A"
                                BorderThickness="1,1,1,2">
                            <Border x:Name="Face" CornerRadius="5"
                                    Margin="1,1,1,1"
                                    BorderBrush="#3D4B63"
                                    BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2C374A" Offset="0.0"/>
                                        <GradientStop Color="#1A212E" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#38465D" Offset="0.0"/>
                                            <GradientStop Color="#232B3B" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#5B7093"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#181F2B" Offset="0.0"/>
                                            <GradientStop Color="#121721" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Base" CornerRadius="6"
                                Background="#2A0E0E"
                                BorderBrush="#5C1A1A"
                                BorderThickness="1,1,1,2">
                            <Border x:Name="Face" CornerRadius="5"
                                    Margin="1,1,1,1"
                                    BorderBrush="#E05050"
                                    BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#C03030" Offset="0.0"/>
                                        <GradientStop Color="#8B2020" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#D83838" Offset="0.0"/>
                                            <GradientStop Color="#A02828" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#FF7070"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#8B1C1C" Offset="0.0"/>
                                            <GradientStop Color="#6A1515" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- §173: SuccessButton naik ke tingkat aplikasi - salinan
             verbatim style lokal MacroManagerWindow (chrome Base/Face
             yang sama dengan Primary/Danger, gradasi hijau #2FA84F→
             #1E7A34). Dipakai tombol service "Mulai"; salinan lokal di
             MacroManagerWindow dibiarkan (bayangan lokal, visual sama). -->
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Base" CornerRadius="6"
                                Background="#0E2A14"
                                BorderBrush="#1A5C2E"
                                BorderThickness="1,1,1,2">
                            <Border x:Name="Face" CornerRadius="5"
                                    Margin="1,1,1,1"
                                    BorderBrush="#4ADE80"
                                    BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2FA84F" Offset="0.0"/>
                                        <GradientStop Color="#1E7A34" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#3DBB5F" Offset="0.0"/>
                                            <GradientStop Color="#2A8F42" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#6EE7A0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1E6B2E" Offset="0.0"/>
                                            <GradientStop Color="#145A24" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Default button style for any plain button across the app: 3D raised embossed style -->
        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}"/>
        <!-- §160 XButtonStyle: SATU style bersama untuk tombol ✕ (hapus).
             Salinan verbatim template style Button implisit lokal
             BindingEditorWindow.xaml:16-75 (varian lokal: CornerRadius
             Base 5 / Face 4, Padding 12,5, CyberTechFont + SemiBold) -
             BUKAN GhostButton (6/5), agar panel referensi kombinasi
             tetap piksel-identik. MinWidth="0" eksplisit: menetralkan
             rembesan MinWidth 86 dari style implisit lokal Dialog/Obs
             (§78). Margin TIDAK dibawa (layout per situs); glyph,
             ukuran glyph, dan foreground tetap di konten tiap situs
             (merah #F87171 = hapus, netral = tutup/bersihkan).
             Chrome jendela (ShellChromeButton) dan kotak kecil
             terkendala ruang TIDAK memakai style ini - lihat
             keystream-160-inventory.md. -->
        <Style x:Key="XButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource CyberTechFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Base" CornerRadius="5"
                                Background="#10131C"
                                BorderBrush="#222B3A"
                                BorderThickness="1,1,1,2">
                            <Border x:Name="Face" CornerRadius="4"
                                    Margin="1,1,1,1"
                                    BorderBrush="#3D4B63"
                                    BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2C374A" Offset="0.0"/>
                                        <GradientStop Color="#1A212E" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#38465D" Offset="0.0"/>
                                            <GradientStop Color="#232B3B" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#5B7093"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#181F2B" Offset="0.0"/>
                                            <GradientStop Color="#121721" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#242B38" Offset="0"/>
                        <GradientStop Color="#161922" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="10,3.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <views:ChamferBorder x:Name="Bd" IsHexagon="True" Chamfer="9"
                                             Background="{TemplateBinding Background}"
                                             BorderBrush="{TemplateBinding BorderBrush}"
                                             BorderThickness="1.0"
                                             Padding="{TemplateBinding Padding}"
                                             SpecularTopHighlight="False">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </views:ChamferBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#253144"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2585D8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12151D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ShellChromeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333C52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ShellCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333C52"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2B3242" Offset="0"/>
                        <GradientStop Color="#1B1F28" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>
        <!-- Every text field in the app gets a clear (x) button inside it
             (v2.9.25, the user's request): shown only when the field has
             text and is editable. The click handler lives in App.xaml.cs
             and clears the templated TextBox, bindings included. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E222D"/>
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="BorderBrush" Value="#3A4152"/>
            <Setter Property="BorderThickness" Value="2"/>
            <!-- §163: MinHeight 30 = pola ComboBox global (App.xaml:104) -
                 kotak tanpa Height eksplisit (mis. Nama tampilan, dulu 24px)
                 kini setinggi dropdown 30px; Height lokal 32/34/36/28 tetap
                 berlaku lewat preseden MinHeight > MaxHeight > Height. -->
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="7,0,26,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="CaretBrush" Value="#E8EAF0"/>
            <Setter Property="SelectionBrush" Value="#1E86E0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <Grid>
                                <TextBlock x:Name="PlaceholderText"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#5D6980"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           Margin="7,0,26,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"/>
                                <!-- §78: MinWidth="0" eksplisit - WAJIB.
                                     Jendela OBS punya Style Button implisit
                                     lokal (MinWidth 86) yang merembes ke
                                     tombol ini: Width lokal 20 kalah oleh
                                     MinWidth 86 (lebar akhir = max(20,86)),
                                     sehingga tombol × tampil memanjang
                                     86×20 di kolom Host/Password OBS.
                                     Nilai lokal mengalahkan setter style,
                                     jadi MinWidth 0 menetralkan rembesan
                                     itu di semua jendela, tanpa mengubah
                                     tampilan × di tempat lain (defaultnya
                                     memang 0). -->
                                <Button x:Name="ClearBtn" Width="20" Height="20" MinWidth="0" Padding="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                                        Background="#2A2F3A" BorderBrush="#3A4152" BorderThickness="1"
                                        Cursor="Hand" Focusable="False" ToolTip="{Binding [S0001], Source={x:Static loc:LocSource.Instance}, Mode=OneWay}"
                                        Click="ClearTextBox_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="&#x2715;" FontSize="11" FontFamily="{StaticResource CyberTechFont}" FontWeight="SemiBold" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ClearBtn" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="ClearBtn" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1E86E0"/>
                            </Trigger>
                            <!-- §109: trigger nonaktif selama ini HILANG -
                                 template ini mengganti template bawaan,
                                 jadi TextBox yang dinonaktifkan tampil
                                 persis seperti yang aktif (latar/teks/
                                 tombol × sama terangnya). ComboBox di atas
                                 dan PrimaryButton meredup ke Opacity 0.5
                                 saat nonaktif; samakan di sini agar
                                 TextBox nonaktif (mis. ambang/jeda di
                                 Pengaturan Mouse saat Persis hidup)
                                 terlihat greyed, termasuk tombol × di
                                 dalamnya yang ikut meredup. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ListBox tidak pernah punya style global (25 Okt 2026): semua
             ListBox telanjang tampil putih bawaan WPF - mencolok di tema
             gelap. Style ini menyamakan ListBox dengan TextBox/ComboBox
             (#1E222D, border #3A4152, seleksi biru #1E86E0). ListBox yang
             sudah mengatur Background/ItemContainerStyle sendiri
             (drawer aplikasi, daftar mode) tidak berubah karena nilai
             lokal menang atas setter style.
             Template (§71): style ini SENGAJA mengganti template
             bawaan WPF dengan salinannya tanpa trigger nonaktif.
             Template bawaan punya trigger IsEnabled=False yang
             mengecat latar border jadi terang (warna sistem) - itu
             yang membuat daftar macro jadi PUTIH saat merekam
             (MacroList dinonaktifkan selama rekaman). Template ini
             identik dengan bawaan (Border + ScrollViewer +
             ItemsPresenter; properti ScrollViewer.* diwariskan ke
             ScrollViewer dalam template, jadi tidak perlu binding
             eksplisit; ItemsPanel bawaan/virtualisasi tidak
             disentuh karena tetap lewat ItemsPresenter) kecuali
             tanpa trigger tersebut - daftar nonaktif tampil persis
             seperti daftar aktif (gelap, seleksi tetap biru),
             konsisten dengan tombol aplikasi yang juga tidak
             meredup saat nonaktif. -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1E222D"/>
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="BorderBrush" Value="#3A4152"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="1" SnapsToDevicePixels="True">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E86E0"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsSelected" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#252B38"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <!-- Tab gelap (25 Okt 2026): TabControl/TabItem bawaan WPF tampil
             terang dan merusak tema - samakan dengan ListBox gelap
             (#1E222D, terpilih biru #1E86E0). Dipakai sub-tab manager grup. -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#1E222D"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#3A4152"
                                BorderThickness="1,1,1,0" CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252B38"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E86E0"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Width" Value="172"/>
            <Setter Property="Height" Value="118"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="12">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
